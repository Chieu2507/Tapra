{% liquid
  assign cart_drawer_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign cart_drawer_scheme = section.settings.color_scheme.id
  endif
  assign cart_drawer_scheme = cart_drawer_scheme | default: 'scheme-1' | handleize
  assign cart_drawer_title = section.settings.title | default: 'Cart'
  assign cart_drawer_title_size = settings.overlay_title_size | default: 'md'
  assign cart_drawer_custom_title_size = settings.overlay_custom_title_size | default: 24
  assign cart_drawer_title_size_class = 'heading-md'
  case cart_drawer_title_size
    when 'display', 'heading_1'
      assign cart_drawer_title_size_class = 'heading-display'
    when 'xl', 'heading_2'
      assign cart_drawer_title_size_class = 'heading-xl'
    when 'lg', 'heading_3'
      assign cart_drawer_title_size_class = 'heading-lg'
    when 'md', 'heading_4'
      assign cart_drawer_title_size_class = 'heading-md'
    when 'sm', 'heading_5'
      assign cart_drawer_title_size_class = 'heading-sm'
    when 'xs', 'heading_6'
      assign cart_drawer_title_size_class = 'heading-xs'
    when 'custom'
      assign cart_drawer_title_size_class = 'heading-custom'
  endcase
  assign cart_drawer_title_limit = section.settings.title_line_limit | default: 'none'
  assign cart_drawer_show_count = section.settings.show_cart_count
  assign cart_drawer_share_label = 'cart_drawer.share_cart' | t
  assign cart_drawer_share_copied_label = 'cart_drawer.cart_link_copied' | t
  assign cart_drawer_share_error_label = 'cart_drawer.share_error' | t
  assign cart_drawer_threshold = section.settings.free_shipping_threshold | default: 100 | times: 100
  assign cart_drawer_shipping_total = cart.items_subtotal_price | default: cart.total_price
  assign cart_drawer_remaining = cart_drawer_threshold | minus: cart_drawer_shipping_total
  if cart_drawer_remaining < 0
    assign cart_drawer_remaining = 0
  endif
  assign cart_drawer_progress = 0
  if cart_drawer_threshold > 0
    assign cart_drawer_progress = cart_drawer_shipping_total | times: 100.0 | divided_by: cart_drawer_threshold
    if cart_drawer_progress > 100
      assign cart_drawer_progress = 100
    endif
  endif
  assign cart_drawer_pending_template = section.settings.free_shipping_pending_message | default: "You are {amount} away from free shipping!"
  assign cart_drawer_success_template = section.settings.free_shipping_success_message | default: "Congratulations! You are eligible for free shipping!"
  assign cart_drawer_pending_message = cart_drawer_pending_template
  assign cart_drawer_success_message = cart_drawer_success_template
  assign cart_drawer_promotion_message = section.settings.promotion_message | replace: '[code]', section.settings.promotion_code
  assign cart_drawer_remaining_money = cart_drawer_remaining | money_with_currency
  assign cart_drawer_pending_message = cart_drawer_pending_message | replace: '{amount}', cart_drawer_remaining_money
  assign cart_drawer_original_total = 0
  for item in cart.items
    assign cart_drawer_item_current_price = item.original_price | default: item.price
    assign cart_drawer_item_compare_price = item.variant.compare_at_price | default: 0
    assign cart_drawer_selling_plan_compare_price = item.selling_plan_allocation.compare_at_price | default: 0
    if cart_drawer_selling_plan_compare_price > cart_drawer_item_compare_price
      assign cart_drawer_item_compare_price = cart_drawer_selling_plan_compare_price
    endif
    if item.original_price > cart_drawer_item_compare_price
      assign cart_drawer_item_compare_price = item.original_price
    endif
    if cart_drawer_item_compare_price < cart_drawer_item_current_price
      assign cart_drawer_item_compare_price = cart_drawer_item_current_price
    endif
    assign cart_drawer_item_original_line = cart_drawer_item_compare_price | times: item.quantity
    assign cart_drawer_original_total = cart_drawer_original_total | plus: cart_drawer_item_original_line
  endfor
  assign cart_drawer_savings = cart_drawer_original_total | minus: cart.total_price
  if cart_drawer_savings < 0
    assign cart_drawer_savings = 0
  endif
  assign cart_drawer_discount_count = cart.cart_level_discount_applications.size | default: 0
  if cart_drawer_remaining == 0
    assign cart_drawer_shipping_message = cart_drawer_success_message
  else
    assign cart_drawer_shipping_message = cart_drawer_pending_message
  endif
  assign cart_drawer_padding_desktop = 'var(--overlay-drawer-content-padding-desktop)'
  assign cart_drawer_padding_mobile = 'var(--overlay-drawer-content-padding-mobile)'
  assign cart_drawer_inset_desktop = '0px'
  assign cart_drawer_edge_radius_desktop = '0px'
  if section.settings.enable_padding_desktop != false
    assign cart_drawer_inset_desktop = 'var(--overlay-drawer-padding-desktop)'
    assign cart_drawer_edge_radius_desktop = 'var(--overlay-drawer-edge-radius-desktop)'
  endif
  capture cart_drawer_remove_icon
    render 'icon', icon: 'trash', bare: true
  endcapture
  assign cart_drawer_remove_icon = cart_drawer_remove_icon | strip
  assign cart_drawer_remove_icon_data = cart_drawer_remove_icon | escape
  capture cart_drawer_decrease_icon
    render 'icon', icon: 'minus', bare: true
  endcapture
  assign cart_drawer_decrease_icon = cart_drawer_decrease_icon | strip
  assign cart_drawer_decrease_icon_data = cart_drawer_decrease_icon | escape
  capture cart_drawer_increase_icon
    render 'icon', icon: 'plus', bare: true
  endcapture
  assign cart_drawer_increase_icon = cart_drawer_increase_icon | strip
  assign cart_drawer_increase_icon_data = cart_drawer_increase_icon | escape
  capture cart_drawer_discount_icon
    render 'icon', icon: 'tag', bare: true
  endcapture
  assign cart_drawer_discount_icon = cart_drawer_discount_icon | strip
  assign cart_drawer_discount_icon_data = cart_drawer_discount_icon | escape
  capture cart_drawer_recommendation_icon
    render 'icon', icon: 'shopping-bag', bare: true
  endcapture
  assign cart_drawer_recommendation_icon = cart_drawer_recommendation_icon | strip
  assign cart_drawer_recommendation_icon_data = cart_drawer_recommendation_icon | escape
%}

{% if section.settings.show_recommendations %}
  <script type="module" src="{{ 'cart-drawer-recommendations.js' | asset_url }}"></script>
{% endif %}

{% render 'deferred-stylesheet', filename: 'cart-drawer.css' %}

<div
  id="CartDrawer"
  class="component-overlay cart-drawer color-scheme section-color-scope {{ cart_drawer_scheme }}{% if section.settings.product_cards %} cart-drawer--product-cards{% endif %}{% if section.settings.enable_block_animations %} cart-drawer--animated{% endif %}"
  data-component-overlay
  data-append-to-body
  data-desktop-layout="drawer"
  data-mobile-layout="drawer"
  data-state="closed"
  scroll-lock
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="{{ cart_drawer_title | escape }}"
  aria-labelledby="CartDrawerHeading"
  hidden
  data-cart-drawer
  data-section-id="{{ section.id }}"
  style="--component-overlay-width: {{ section.settings.desktop_width | default: 550 }}px; --cart-drawer-padding-desktop: {{ cart_drawer_padding_desktop }}; --cart-drawer-padding-mobile: {{ cart_drawer_padding_mobile }}; --cart-drawer-inset-desktop: {{ cart_drawer_inset_desktop }}; --cart-drawer-edge-radius-desktop: {{ cart_drawer_edge_radius_desktop }}; --cart-drawer-shipping-progress-color: {{ section.settings.progress_bar_color | default: 'var(--sale-price-color)' }}; --cart-drawer-shipping-success-color: {{ section.settings.free_shipping_success_color | default: '#5d874f' }};"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-cart-change-url="{{ routes.cart_change_url }}"
  data-cart-update-url="{{ routes.cart_update_url }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-cart-add-error="{{ 'cart.add_error' | t | escape }}"
  data-cart-update-error="{{ 'cart.update_error' | t | escape }}"
  data-cart-note-saved="{{ 'cart_drawer.note_saved' | t | escape }}"
  data-cart-note-error="{{ 'cart_drawer.note_error' | t | escape }}"
  data-cart-discount-applied="{{ 'cart_drawer.discount_applied' | t | escape }}"
  data-cart-discount-error="{{ 'cart_drawer.discount_error' | t | escape }}"
  data-cart-shipping-calculating="{{ 'cart_drawer.shipping_calculating' | t | escape }}"
  data-cart-shipping-unavailable="{{ 'cart_drawer.shipping_unavailable' | t | escape }}"
  data-cart-shipping-no-rates="{{ 'cart_drawer.shipping_no_rates' | t | escape }}"
  data-recommendations-enabled="{{ section.settings.show_recommendations }}"
  data-recommendations-limit="{{ section.settings.recommendations_limit | default: 4 }}"
  data-show-cart-count="{{ cart_drawer_show_count }}"
  data-enable-back-in-stock-alert="{{ section.settings.enable_back_in_stock_alert }}"
  data-shipping-threshold="{{ cart_drawer_threshold }}"
  data-show-amount-range="{{ section.settings.show_amount_range }}"
  data-free-shipping-enabled="{{ section.settings.free_shipping_enable }}"
  data-free-shipping-pending-message="{{ cart_drawer_pending_template | escape }}"
  data-free-shipping-success-message="{{ cart_drawer_success_template | escape }}"
  data-show-sale-price-first="{{ section.settings.show_sale_price_first }}"
  data-title-line-limit="{{ cart_drawer_title_limit }}"
  data-cart-icon="{{ section.settings.cart_icon | default: 'cart' }}"
  data-promotion-code="{{ section.settings.promotion_code | escape }}"
  data-free-shipping-message="{{ cart_drawer_shipping_message | escape }}"
  data-empty-message="{{ 'cart.empty' | t | escape }}"
  data-continue-shopping-label="{{ 'cart.continue_shopping' | t | escape }}"
  data-continue-shopping-url="{{ routes.all_products_collection_url }}"
  data-remove-label="{{ 'cart.remove' | t | escape }}"
  data-decrease-label="{{ 'cart.decrease' | t | escape }}"
  data-increase-label="{{ 'cart.increase' | t | escape }}"
  data-quantity-label="{{ 'accessibility.quantity' | t | escape }}"
  data-remove-icon="{{ cart_drawer_remove_icon_data }}"
  data-decrease-icon="{{ cart_drawer_decrease_icon_data }}"
  data-increase-icon="{{ cart_drawer_increase_icon_data }}"
  data-discount-icon="{{ cart_drawer_discount_icon_data }}"
  data-recommendation-icon="{{ cart_drawer_recommendation_icon_data }}"
>
  <button class="component-overlay__backdrop backdrop-blur cart-drawer__backdrop" type="button" tabindex="-1" aria-label="{{ 'cart.close' | t | escape }}" data-component-overlay-backdrop></button>

  <aside class="component-overlay__panel cart-drawer__panel drawer surface-light" data-drawer>
    <div class="cart-drawer__inner">
      <header class="component-overlay__header cart-drawer__header">
        <h2 class="drawer__title {{ cart_drawer_title_size_class }}" id="CartDrawerHeading" data-cart-drawer-title data-title-limit="{{ cart_drawer_title_limit }}"{% if cart_drawer_title_size == 'custom' %} style="--overlay-title-size: {{ cart_drawer_custom_title_size }}px"{% endif %}>
          {{ cart_drawer_title | escape }}{% if cart_drawer_show_count %} <span class="cart-drawer__item-count body-text body-xs" data-cart-drawer-item-count aria-label="{{ cart.item_count }}">({{ cart.item_count }})</span>{% endif %}
        </h2>
        <div class="cart-drawer__header-actions">
          {% if section.settings.enable_share_cart %}
            {% render 'share-button',
              label: cart_drawer_share_label,
              url: routes.cart_url,
              title: cart_drawer_title,
              copied_label: cart_drawer_share_copied_label,
              error_label: cart_drawer_share_error_label,
              class: 'icon-button cart-drawer__share'
            %}
          {% endif %}
          <button class="overlay-close component-overlay__close cart-drawer__close" type="button" aria-label="{{ 'cart.close' | t | escape }}" data-overlay-close>{% render 'icon', icon: 'x-mark', bare: true, class: 'overlay-close__icon' %}</button>
        </div>
      </header>

      <div class="cart-drawer__body scrollbar scrollbar--vertical" data-cart-drawer-content aria-live="polite">
        <p class="cart-drawer__status visually-hidden" data-cart-drawer-status role="status" aria-live="polite" hidden></p>
        <div class="cart-drawer__loading" data-cart-drawer-loading hidden aria-hidden="true"><span class="cart-drawer__loading-spinner"></span></div>

        {% if section.settings.free_shipping_enable %}
          <div class="cart-drawer__shipping-progress" data-cart-drawer-shipping-progress data-unlocked="{% if cart_drawer_remaining == 0 %}true{% else %}false{% endif %}"{% unless cart.item_count > 0 and cart.requires_shipping %} hidden{% endunless %}>
            <div class="cart-drawer__shipping-progress-copy">
              <span class="cart-drawer__shipping-progress-icon" aria-hidden="true">
                {% render 'icon', icon: 'truck', bare: true %}
                <svg class="cart-drawer__shipping-progress-success-icon" viewBox="0 0 20 20" fill="none" focusable="false" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" fill="currentColor" />
                  <path d="m6 10 2.5 2.5L14 7" stroke="var(--background-color)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div class="cart-drawer__shipping-progress-details">
                <p class="body-text body-sm"><span data-cart-drawer-shipping-message>{{ cart_drawer_shipping_message }}</span></p>
                <span class="cart-drawer__shipping-progress-track" aria-hidden="true"><span data-cart-drawer-shipping-progress-value style="width: {{ cart_drawer_progress }}%;"></span></span>
              </div>
            </div>
            {% if section.settings.show_amount_range %}
              <p class="cart-drawer__shipping-progress-goal body-text body-sm"><span class="body-xs">Free shipping</span><span data-cart-drawer-shipping-goal data-complete-label="You've got it!">{% if cart_drawer_remaining == 0 %}You've got it!{% else %}{{ cart_drawer_threshold | money_with_currency }}{% endif %}</span></p>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.promotion_enable and section.settings.promotion_message != blank %}
          <div class="cart-drawer__promotion" data-cart-drawer-promotion{% unless cart.item_count > 0 %} hidden{% endunless %}>
            <span class="cart-drawer__promotion-copy body-text body-sm">
              {% render 'icon', icon: 'tag', bare: true %}
              {{ cart_drawer_promotion_message | escape }}
            </span>
            {% if section.settings.promotion_code != blank %}
              <button class="cart-drawer__promotion-action body-text body-sm link-underline" type="button" data-cart-drawer-promotion-apply>{{ section.settings.promotion_action_label | default: 'Use coupon' | escape }}</button>
            {% endif %}
          </div>
        {% endif %}

          <div class="cart-drawer__items" data-cart-drawer-items{% unless cart.item_count > 0 %} hidden{% endunless %}>
            {% if cart.item_count > 0 %}
            {% for item in cart.items %}
              {% assign line_current_price = item.original_price | default: item.price %}
              {% assign line_original_price = item.variant.compare_at_price | default: 0 %}
              {% assign line_selling_plan_compare_price = item.selling_plan_allocation.compare_at_price | default: 0 %}
              {% if line_selling_plan_compare_price > line_original_price %}
                {% assign line_original_price = line_selling_plan_compare_price %}
              {% endif %}
              {% if item.original_price > line_original_price %}
                {% assign line_original_price = item.original_price %}
              {% endif %}
              {% if line_original_price < line_current_price %}
                {% assign line_original_price = line_current_price %}
              {% endif %}
              {% assign line_is_sale = false %}
              {% if line_original_price > line_current_price %}
                {% assign line_is_sale = true %}
              {% endif %}
              <article class="cart-drawer__item{% if line_is_sale %} is-sale{% endif %}" data-cart-line data-line-key="{{ item.key | escape }}" data-variant-id="{{ item.variant_id }}" data-compare-price="{{ line_original_price }}">
                <a class="cart-drawer__item-media" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
                  {% render 'image', image: item.image, class: 'cart-drawer__image', width: 240, widths: '120, 180, 240', sizes: '7rem', placeholder: 'product-1' %}
                </a>
                <div class="cart-drawer__item-info">
                  <h3 class="cart-drawer__item-title card-title-text"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>
                  {% if item.product.has_only_default_variant == false and item.variant.title != 'Default Title' %}
                    <p class="cart-drawer__item-options body-text body-sm">{{ item.variant.title | escape }}</p>
                  {% endif %}
                  {% if item.properties != blank %}
                    <dl class="cart-drawer__item-properties body-text body-sm">
                      {% for property in item.properties %}
                        {% unless property.last == blank %}<div><dt>{{ property.first | escape }}</dt><dd>{{ property.last | escape }}</dd></div>{% endunless %}
                      {% endfor %}
                    </dl>
                  {% endif %}
                  <p class="cart-drawer__item-price card-price-text body-md{% if line_is_sale %} is-sale{% endif %}">
                    {% if line_is_sale and section.settings.show_sale_price_first == false %}<s class="cart-drawer__item-price-compare body-sm">{{ line_original_price | money }}</s>{% endif %}
                    <span class="cart-drawer__item-price-current">{{ line_current_price | money }}</span>
                    {% if line_is_sale and section.settings.show_sale_price_first != false %}<s class="cart-drawer__item-price-compare body-sm">{{ line_original_price | money }}</s>{% endif %}
                    {% if item.unit_price and item.unit_price_measurement %}<small class="cart-drawer__item-unit-price body-xs">{{ item.unit_price | money }} / {{ item.unit_price_measurement.reference_value }}{{ item.unit_price_measurement.reference_unit }}</small>{% endif %}
                  </p>
                </div>
                <div class="cart-drawer__item-actions">
                  <button class="cart-drawer__remove" type="button" data-cart-remove data-line-key="{{ item.key | escape }}" data-line-index="{{ forloop.index }}" aria-label="{{ 'cart.remove' | t | escape }}">
                    {% render 'icon', icon: 'trash', bare: true %}
                  </button>
                  <div class="cart-drawer__quantity" data-cart-quantity>
                    <button type="button" data-cart-quantity-action="decrease" data-line-key="{{ item.key | escape }}" data-line-index="{{ forloop.index }}" aria-label="{{ 'cart.decrease' | t | escape }}"><span class="cart-drawer__quantity-icon" aria-hidden="true">{{ cart_drawer_decrease_icon }}</span></button>
                    <input id="CartDrawerQuantity-{{ item.key | handleize }}" type="number" min="0" value="{{ item.quantity }}" inputmode="numeric" aria-label="{{ 'accessibility.quantity' | t | escape }}" data-cart-quantity-input data-line-key="{{ item.key | escape }}" data-line-index="{{ forloop.index }}">
                    <button type="button" data-cart-quantity-action="increase" data-line-key="{{ item.key | escape }}" data-line-index="{{ forloop.index }}" aria-label="{{ 'cart.increase' | t | escape }}"><span class="cart-drawer__quantity-icon" aria-hidden="true">{{ cart_drawer_increase_icon }}</span></button>
                  </div>
                </div>
              </article>
            {% endfor %}
            {% endif %}
          </div>
          <div class="cart-drawer__empty" data-cart-drawer-empty{% if cart.item_count > 0 %} hidden{% endif %}>
            <span class="cart-drawer__empty-icon" aria-hidden="true">
              {% if section.settings.cart_icon == 'bag' %}
                {% render 'icon', icon: 'shopping-bag', bare: true %}
              {% else %}
                {% render 'icon', icon: 'shopping-cart', bare: true %}
              {% endif %}
            </span>
            <p class="body-text body-md">{{ 'cart.empty' | t }}</p>
            <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
          </div>

        {% if section.settings.show_recommendations %}
          <section class="cart-drawer__recommendations" data-cart-drawer-recommendations hidden aria-labelledby="CartDrawerRecommendationsHeading">
            <div class="cart-drawer__section-heading">
              <h3 id="CartDrawerRecommendationsHeading" class="cart-drawer__section-title heading-text heading-sm">{{ section.settings.recommendations_heading | default: 'You may also like' | escape }}</h3>
              <div
                class="swiper-pagination cart-drawer__recommendation-pagination"
                data-cart-drawer-recommendation-pagination
                aria-label="{{ section.settings.recommendations_heading | default: 'You may also like' | escape }}"
              ></div>
            </div>
            <div
              class="swiper swiper-carousel--carousel cart-drawer__recommendation-list"
              data-swiper-carousel
              data-swiper-layout="carousel"
              data-cart-drawer-recommendation-list
              aria-label="{{ section.settings.recommendations_heading | default: 'You may also like' | escape }}"
            >
              <div class="swiper-wrapper"></div>
            </div>
          </section>
        {% endif %}

      </div>

      <footer class="cart-drawer__footer" data-cart-drawer-footer{% unless cart.item_count > 0 %} hidden{% endunless %}>
        {% if section.settings.show_order_note or section.settings.show_shipping_estimator or section.settings.show_discount %}
          <div class="cart-drawer__order-options-actions" role="group" aria-label="Cart options">
            {% if section.settings.show_order_note %}
              <button class="cart-drawer__order-options-action" type="button" aria-expanded="false" data-cart-drawer-order-options-open="note" data-cart-drawer-order-options-title="{{ section.settings.order_note_label | default: 'Order note' | escape }}"><span class="cart-drawer__order-options-action-icon" aria-hidden="true">{% render 'icon', icon: 'document-text', bare: true %}</span><span class="cart-drawer__order-options-action-copy body-text body-sm"><span class="body-md">{{ section.settings.order_note_label | default: 'Order note' }}</span><small class="body-xs">Add a note</small></span></button>
            {% endif %}
            {% if section.settings.show_shipping_estimator %}
              <button class="cart-drawer__order-options-action" type="button" aria-expanded="false" data-cart-drawer-order-options-open="shipping" data-cart-drawer-order-options-title="{{ section.settings.shipping_estimator_label | default: 'Estimate shipping' | escape }}"><span class="cart-drawer__order-options-action-icon" aria-hidden="true">{% render 'icon', icon: 'truck', bare: true %}</span><span class="cart-drawer__order-options-action-copy body-text body-sm"><span class="body-md">Shipping</span><small class="body-xs">Calculated at checkout</small></span></button>
            {% endif %}
            {% if section.settings.show_discount %}
              <button class="cart-drawer__order-options-action" type="button" aria-expanded="false" data-cart-drawer-order-options-open="discount" data-cart-drawer-order-options-title="{{ section.settings.discount_label | default: 'Discount' | escape }}"><span class="cart-drawer__order-options-action-icon" aria-hidden="true">{% render 'icon', icon: 'tag', bare: true %}</span><span class="cart-drawer__order-options-action-copy body-text body-sm"><span class="body-md">{{ section.settings.discount_label | default: 'Discount' }} <span class="cart-drawer__order-options-discount-count" data-cart-drawer-discount-count{% if cart_drawer_discount_count == 0 %} hidden{% endif %}>{{ cart_drawer_discount_count }}</span></span><small class="body-xs">Add code</small></span></button>
            {% endif %}
          </div>
        {% endif %}
        <p class="cart-drawer__message body-text body-sm" data-cart-drawer-message role="status" aria-live="polite" hidden></p>
        <div class="cart-drawer__totals body-text body-sm">
          <div><span>Subtotal</span><span data-cart-drawer-subtotal>{{ cart.items_subtotal_price | default: cart.total_price | money_with_currency }}</span></div>
          <div><span>Shipping</span><span>Calculated at checkout</span></div>
          <div class="cart-drawer__summary body-text body-md"><span>{{ section.settings.total_label | default: 'Total' }}</span><span class="heading-text heading-sm" data-cart-drawer-total>{{ cart.total_price | money_with_currency }}</span></div>
          <p class="cart-drawer__savings body-text body-sm" data-cart-drawer-savings{% unless cart_drawer_savings > 0 %} hidden{% endunless %}><span>You have saved <span data-cart-drawer-savings-value>{{ cart_drawer_savings | money_with_currency }}</span>!</span><s data-cart-drawer-original-total>{{ cart_drawer_original_total | money_with_currency }}</s></p>
        </div>
        <div class="cart-drawer__actions">
          <form class="cart-drawer__checkout-form" action="{{ routes.cart_url }}" method="post">
            <button class="btn btn--primary cart-drawer__checkout" type="submit" name="checkout">{{ section.settings.checkout_label | default: 'Checkout' }}</button>
          </form>
        </div>
        {% if shop.enabled_payment_types != blank %}
          <div class="cart-drawer__payment-icons" aria-label="{{ 'accessibility.payment_methods' | t | escape }}">
            {% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}
          </div>
        {% endif %}
        {% if additional_checkout_buttons %}<div class="cart-drawer__additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>{% endif %}
      </footer>

      {% if section.settings.show_order_note or section.settings.show_shipping_estimator or section.settings.show_discount %}
        <button class="cart-drawer__order-options-backdrop" type="button" aria-label="Close cart options" data-cart-drawer-order-options-close></button>
        <section class="bottom-sheet cart-drawer__order-options-panel component-sheet color-scheme section-color-scope scheme-1 scrollbar scrollbar--both surface-light" data-bottom-sheet data-cart-drawer-order-options aria-hidden="true">
          <header class="cart-drawer__order-options-header component-sheet__header" data-cart-drawer-order-options-sheet-header><span class="bottom-sheet__handle cart-drawer__order-options-sheet-handle" aria-hidden="true"></span><h3 class="heading-text heading-sm" data-cart-drawer-order-options-title>Cart options</h3><button class="overlay-close cart-drawer__order-options-close" type="button" aria-label="Close cart options" data-cart-drawer-order-options-close>{% render 'icon', icon: 'x-mark', bare: true, class: 'overlay-close__icon' %}</button></header>
          <div class="cart-drawer__order-options-content">
            {% if section.settings.show_order_note %}<div data-cart-drawer-order-options-content="note" hidden><label class="form__label" for="CartDrawerNote">Order special instructions</label><textarea class="form__control form__control--textarea" id="CartDrawerNote" rows="5" data-cart-drawer-note placeholder="{{ section.settings.order_note_placeholder | default: 'Add a note to your order' | escape }}">{{ cart.note | escape }}</textarea><button class="btn btn--primary cart-drawer__order-options-submit" type="button" data-cart-drawer-save-note>{{ section.settings.order_note_save_label | default: 'Save note' }}</button></div>{% endif %}
            {% if section.settings.show_shipping_estimator %}<div data-cart-drawer-order-options-content="shipping" hidden><form class="cart-drawer__shipping-estimator" data-cart-drawer-shipping-estimator><label class="form__label"><span>{{ 'cart_drawer.country' | t }}</span><select class="form__control form__control--select" name="country" data-cart-drawer-shipping-country required>{{ all_country_option_tags }}</select></label><label class="form__label"><span>{{ 'cart_drawer.postal_code' | t }}</span><input class="form__control form__control--input" type="text" name="zip" autocomplete="postal-code" required></label><button class="btn btn--primary cart-drawer__order-options-submit" type="submit">{{ 'cart_drawer.calculate' | t }}</button></form><div class="cart-drawer__shipping-rates body-text body-sm" data-cart-drawer-shipping-rates role="status" aria-live="polite"></div></div>{% endif %}
            {% if section.settings.show_discount %}<div data-cart-drawer-order-options-content="discount" hidden><form class="cart-drawer__discount" data-cart-drawer-discount><label class="form__label visually-hidden" for="CartDrawerDiscount">{{ 'cart_drawer.discount_code' | t }}</label><input class="form__control form__control--input" id="CartDrawerDiscount" type="text" name="discount" autocomplete="off" placeholder="{{ 'cart_drawer.discount_code' | t | escape }}"><button class="btn btn--primary cart-drawer__order-options-submit" type="submit">{{ 'cart_drawer.apply' | t }}</button></form><ul class="cart-drawer__discounts body-text body-sm" data-cart-drawer-discounts role="list" hidden></ul></div>{% endif %}
          </div>
        </section>
      {% endif %}

      <p class="cart-drawer__error form__error" role="alert" data-cart-drawer-error hidden></p>
    </div>
  </aside>
</div>


{% schema %}
{
