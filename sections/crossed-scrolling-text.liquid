{% liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-2'
  assign width_class = 'page-width'
  if section.settings.section_width == 'full_width' or section.settings.section_width == 'full_bleed'
    assign width_class = 'full-width'
  endif
%}
{% capture section_style %}
  --section-padding-top:{{ section.settings.padding_top | default: 0 }}px;
  --section-padding-bottom:{{ section.settings.padding_bottom | default: 60 }}px;
  {% if section.settings.customize_mobile_padding %}
    --section-padding-top-mobile:{{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile }}px;
  {% endif %}
  --crossed-height:{{ section.settings.height | default: 340 }}px;
  {% if section.settings.customize_mobile_height %}--crossed-height-mobile:{{ section.settings.height_mobile }}px;{% endif %}
  --crossed-angle:{{ section.settings.angle | default: 5 }}deg;
  {% if section.settings.background_color != blank %}--crossed-background:{{ section.settings.background_color }};{% endif %}
{% endcapture %}
{% render 'component-stylesheet', filename: 'component-crossed-scrolling-text.css', section_index: section.index %}
<div class="section-spacing crossed-scrolling color-scheme section-color-scope {{ scheme }}" data-crossed-pause="{{ section.settings.pause_on_hover }}" style="{{ section_style | strip }}">
  <div class="container {{ width_class }}{% if section.settings.section_width == 'full_bleed' %} crossed-scrolling--full-bleed{% endif %}">
    <div class="crossed-scrolling__stage">
      <div class="crossed-scrolling__ribbon crossed-scrolling__ribbon--back">{% content_for 'block', type: '_crossed-scrolling-ribbon', id: 'ribbon-back' %}</div>
      <div class="crossed-scrolling__ribbon crossed-scrolling__ribbon--front">{% content_for 'block', type: '_crossed-scrolling-ribbon', id: 'ribbon-front' %}</div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Scrolling text: Crossed",
  "class": "section-crossed-scrolling-text",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "default": "full_bleed",
      "options": [
        {
          "value": "page_width",
          "label": "Page width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        },
        {
          "value": "full_bleed",
          "label": "Full width (no padding)"
        }
      ]
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 160,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 340
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_height",
      "label": "Customize for mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 220,
      "visible_if": "{{ section.settings.customize_mobile_height }}"
    },
    {
      "type": "range",
      "id": "angle",
      "label": "Crossing angle",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "deg",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause both ribbons on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
