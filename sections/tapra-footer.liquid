{% liquid
  assign footer_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign footer_width = 'full-width'
  endif
  assign footer_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-3' | handleize
  assign footer_background = section.settings.background_color | default: section.settings.color_scheme.settings.background
%}
{% style %}
  #shopify-section-{{ section.id }} {
    {% if footer_background != blank %}background-color: {{ footer_background }};{% endif %}
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.customize_mobile_padding %}
      --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    {% endif %}
  }
{% endstyle %}
<script src="{{ 'tapra-footer.js' | asset_url }}" defer></script>
<div class="tapra-footer-frame" data-tapra-footer data-scroll-effect="{{ section.settings.enable_scroll_effect }}">
<footer class="tapra-footer section-spacing color-scheme section-color-scope {{ footer_scheme }}{% if section.settings.show_glow %} tapra-footer--glow{% endif %}">
  {% capture tapra_footer_content %}
  <div class="container {{ footer_width }} tapra-footer__container">
    <div class="tapra-footer__top">
      <div class="tapra-footer__brand">{% content_for 'block', type: 'group', id: 'brand' %}</div>
      <div class="tapra-footer__navigation">{% content_for 'block', type: 'menu', id: 'explore' %}</div>
      <div class="tapra-footer__newsletter">{% content_for 'block', type: 'group', id: 'newsletter' %}</div>
    </div>
    {% if section.settings.wordmark != blank %}
      <div class="tapra-footer__wordmark" aria-hidden="true"><span>{{ section.settings.wordmark | escape }}</span></div>
    {% endif %}
    <div class="tapra-footer__bottom">{% content_for 'block', type: 'group', id: 'credits' %}</div>
  </div>
  {% endcapture %}
  {{ tapra_footer_content | replace: '<a href=', '<a class="link-underline" href=' }}
</footer>
</div>
{% stylesheet %}
  .tapra-footer-frame { overflow: clip; }
  .tapra-footer { position: relative; overflow: clip; }
  .tapra-footer--glow::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(50% 40% at 85% 15%, rgb(59 130 246 / .28), transparent 70%), radial-gradient(60% 45% at 5% 80%, rgb(42 95 214 / .2), transparent 70%);
  }
  .tapra-footer--glow::after {
    content: ''; position: absolute; inset: -10%; pointer-events: none;
    background: repeating-linear-gradient(115deg, transparent 0 140px, rgb(127 180 255 / .06) 140px 230px, transparent 230px 360px);
    filter: blur(36px);
  }
  .tapra-footer__container { position: relative; z-index: 1; container-type: inline-size; }
  .tapra-footer__top { display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(0, .6fr) minmax(0, 1fr); gap: clamp(32px, 4vw, 72px); align-items: start; }
  .tapra-footer__top > * { min-width: 0; }
  .tapra-footer__brand .heading-block { max-width: 680px; }
  .tapra-footer__brand .logo-block .site-logo__fallback {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -.04em;
  }
  .tapra-footer__newsletter { --input-radius: 12px; }
  .tapra-footer__newsletter > .group > .text-block:last-child { text-align: center; }
  .tapra-footer__wordmark { margin-top: clamp(40px, 6vw, 100px); padding-bottom: clamp(10px, 1.4vw, 22px); overflow: hidden; user-select: none; }
  .tapra-footer__wordmark span {
    display: block; width: fit-content; max-width: 100%; padding: 0 .08em .04em 0; font-family: var(--font-heading-family); font-weight: 600;
    font-size: 21.8cqw; letter-spacing: -.065em; line-height: 1; text-transform: uppercase; overflow-wrap: anywhere;
    background: linear-gradient(180deg, #f2f8ff 10%, rgb(191 227 255 / .18) 100%); background-clip: text; -webkit-background-clip: text; color: transparent;
  }
  .tapra-footer__bottom { border-top: 1px solid var(--border-color, rgb(255 255 255 / .1)); padding-top: 24px; }
  .tapra-footer__bottom > .group { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; }
  .tapra-footer__bottom > .group > .menu-block { justify-self: center; }
  .tapra-footer__bottom > .group > .payment-icons-block { justify-self: end; }
  @media (max-width: 1149.98px) {
    .tapra-footer__bottom > .group { grid-template-columns: minmax(0, 1fr); }
    .tapra-footer__bottom > .group > .menu-block,
    .tapra-footer__bottom > .group > .payment-icons-block { justify-self: start; }
  }
  .tapra-footer a { text-decoration: none; }
  .tapra-footer a:focus-visible { outline: 2px solid var(--accent-color, #bfe3ff); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .tapra-footer, .tapra-footer__wordmark span { transform: none !important; opacity: 1 !important; }
  }
  @media (min-width: 768px) and (max-width: 1149.98px) {
    .tapra-footer__top { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .tapra-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 767.98px) {
    .tapra-footer__top { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Tapra footer",
  "class": "section-tapra-footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "TAPRA",
      "info": "Decorative brand lettering. Leave blank to hide."
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color"
    },
    {
      "type": "checkbox",
      "id": "show_glow",
      "label": "Show background glow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_scroll_effect",
      "label": "Enable scroll effect",
      "default": true,
      "info": "Footer reveal and wordmark motion. Disabled for reduced motion and in the theme editor."
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Tapra footer",
      "blocks": {
        "brand": {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "width": "fill",
            "width_mobile": "fill",
            "height": "fit",
            "alignment": "left",
            "horizontal_alignment": "left",
            "position_horizontal": "top",
            "gap_desktop": 26,
            "gap_mobile": 26,
            "appearance_type": "inherit",
            "show_overlay": false
          },
          "blocks": {
            "brand-name": {
              "type": "logo",
              "settings": {
                "style": "transparent",
                "fallback_text": "Tapra\u00ae",
                "width": "custom",
                "width_desktop": 80,
                "width_mobile": 80
              }
            },
            "tagline": {
              "type": "heading",
              "settings": {
                "text": "<p>A little structure for a desk that feels more like you.</p>",
                "heading_size": "custom",
                "custom_heading_size": 40,
                "html_tag": "h2",
                "width": "fill",
                "text_color": "#ffffff"
              }
            },
            "email": {
              "type": "text",
