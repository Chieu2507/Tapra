                "text_size": "md",
                "width": "fill"
              }
            }
          ]
        },
        {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "position": "top",
            "alignment": "left",
            "width": "fill",
            "height": "fill",
            "gap_desktop": 22,
            "gap_mobile": 22,
            "appearance_type": "scheme",
            "color_scheme": "scheme-2",
            "background_color": "#E6EAF0",
            "corner_radius": "radius_24",
            "padding_top": 26,
            "padding_bottom": 26,
            "padding_left": 26,
            "padding_right": 26,
            "animation_type": "slide-bottom",
            "animation_delay": 100
          },
          "blocks": [
            {
              "type": "icon",
              "settings": {
                "source": "custom",
                "custom_icon": "<svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M8 3v4M16 3v4M3 10h18\"/><path d=\"M8 16h8M13 13l3 3-3 3\"/></svg>",
                "icon_width": 48
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>We ship most orders within <strong>24\u201348 hours</strong> and accept returns within <strong>30 days</strong> of receipt.</p>",
                "text_size": "md",
                "width": "fill"
              }
            }
          ]
        },
        {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "position": "top",
            "alignment": "left",
            "width": "fill",
            "height": "fill",
            "gap_desktop": 22,
            "gap_mobile": 22,
            "appearance_type": "scheme",
            "color_scheme": "scheme-2",
            "background_color": "#E6EAF0",
            "corner_radius": "radius_24",
            "padding_top": 26,
            "padding_bottom": 26,
            "padding_left": 26,
            "padding_right": 26,
            "animation_type": "slide-bottom",
            "animation_delay": 200
          },
          "blocks": [
            {
              "type": "icon",
              "settings": {
