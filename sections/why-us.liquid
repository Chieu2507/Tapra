{% liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-2'
  assign width_class = 'page-width'
  if section.settings.section_width == 'full_width' or section.settings.section_width == 'full_bleed'
    assign width_class = 'full-width'
  endif
%}
{% capture section_style %}
  --section-padding-top:{{ section.settings.padding_top | default: 96 }}px;
  --section-padding-bottom:{{ section.settings.padding_bottom | default: 96 }}px;
  {% if section.settings.customize_mobile_padding %}
    --section-padding-top-mobile:{{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile }}px;
  {% endif %}
  --why-columns:{{ section.settings.columns | default: 3 }};
  --why-header-gap:{{ section.settings.header_gap | default: 44 }}px;
  --why-card-gap:{{ section.settings.card_gap | default: 16 }}px;
  {% if section.settings.background_color != blank %}--why-background:{{ section.settings.background_color }};{% endif %}
  {% if section.settings.hover_background != blank %}--why-hover-background:{{ section.settings.hover_background }};{% endif %}
{% endcapture %}
{% render 'component-stylesheet', filename: 'component-why-us.css', section_index: section.index %}
<script src="{{ 'block-animations.js' | asset_url }}" defer></script>
<div class="section-spacing why-us color-scheme section-color-scope {{ scheme }}" data-why-hover="{{ section.settings.hover_effect }}" style="{{ section_style | strip }}">
  <div class="container {{ width_class }}{% if section.settings.section_width == 'full_bleed' %} why-us--full-bleed{% endif %}">
    <div class="why-us__header">{% content_for 'block', type: 'group', id: 'header' %}</div>
    <div class="why-us__cards">{% content_for 'blocks' %}</div>
  </div>
</div>
{% schema %}
{
  "name": "Why us",
  "class": "section-why-us",
  "tag": "section",
  "max_blocks": 8,
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "blocks": [
    {
      "type": "group"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "default": "page_width",
      "options": [
        {
          "value": "page_width",
          "label": "Page width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        },
        {
          "value": "full_bleed",
          "label": "Full width (no padding)"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "Header gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Enable card hover effect",
      "default": true
    },
    {
      "type": "color",
      "id": "hover_background",
      "label": "Card hover background",
      "alpha": true,
      "default": "#BFE3FF",
      "visible_if": "{{ section.settings.hover_effect }}"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 96
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "visible_if": "{{ section.settings.customize_mobile_padding }}",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "visible_if": "{{ section.settings.customize_mobile_padding }}",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Why us",
      "category": "t:general.content",
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 96,
        "padding_bottom": 96,
        "customize_mobile_padding": true,
        "padding_top_mobile": 64,
        "padding_bottom_mobile": 64,
        "section_width": "page_width"
      },
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": {
            "direction": "horizontal",
            "wrap": false,
            "position_horizontal": "bottom",
            "horizontal_alignment": "space-between",
            "alignment": "left",
            "width": "fill",
            "height": "fit",
            "gap_desktop": 32,
            "gap_mobile": 20,
            "customize_mobile_alignment": true,
            "alignment_mobile": "left",
            "animation_type": "slide-bottom"
          },
          "blocks": [
            {
              "type": "group",
              "settings": {
                "direction": "vertical",
                "width": "fill",
                "height": "fit",
                "alignment": "left",
                "gap_desktop": 0,
                "gap_mobile": 0
              },
              "blocks": [
                {
                  "type": "heading",
                  "settings": {
                    "text": "<p>Why us?</p>",
                    "heading_size": "xl",
                    "html_tag": "h2"
