{% capture banner_header %}<div class="featured-collection-banner__header">{% content_for 'block', type: 'header', id: 'header' %}</div>{% endcapture %}
{% capture banner_media %}{% content_for 'block', type: 'banner', id: 'banner' %}{% endcapture %}
{% capture banner_products %}{% content_for 'block', type: 'product-list', id: 'carousel-product-list' %}{% endcapture %}
{% render 'featured-collection-banner', section: section, banner_header: banner_header, banner_media: banner_media, banner_products: banner_products %}

{% schema %}
{
  "name": "t:general.featured_collection_banner",
  "class": "section-featured-collection-banner",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "max_blocks": 3,
  "blocks": [
    {
      "type": "header"
    },
    {
      "type": "banner"
    },
    {
      "type": "product-list"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        },
        {
          "value": "full_width_no_padding",
          "label": "t:options.section_width.full_width_no_padding"
        }
      ],
      "default": "page_width"
    },
    {
      "type": "select",
      "id": "header_position",
      "label": "Header position",
      "options": [
        {
          "value": "above",
          "label": "Above section"
        },
        {
          "value": "products",
          "label": "Above products"
        }
      ],
      "default": "above"
    },
    {
      "type": "select",
      "id": "banner_position",
      "label": "t:labels.banner_position",
      "options": [
        {
          "value": "before",
          "label": "t:options.banner_position.before"
        },
        {
          "value": "after",
          "label": "t:options.banner_position.after"
        }
      ],
      "default": "before"
    },
    {
      "type": "select",
      "id": "banner_max_width",
      "label": "Banner maximum width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "banner_custom_max_width",
      "label": "Custom banner maximum width",
      "min": 400,
      "max": 800,
      "step": 4,
      "unit": "px",
      "default": 672,
      "visible_if": "{{ section.settings.banner_max_width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner height",
      "options": [
        {
          "value": "ratio",
          "label": "Image ratio"
        },
        {
          "value": "products",
          "label": "Match product grid"
        }
      ],
      "default": "ratio"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:labels.enable_sticky",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_banner_full_width",
      "label": "Full width banner on mobile",
      "info": "Extend the banner to the screen edges while keeping the header and products inside the container.",
      "default": false
    },
    {
      "type": "header",
      "content": "Tablet layout"
    },
    {
      "type": "checkbox",
      "id": "customize_tablet_layout",
      "label": "Customize tablet layout",
      "info": "Use tablet banner width, overlap and spacing. Top navigation is hidden and Header uses its mobile horizontal padding.",
      "default": false
    },
    {
      "type": "range",
      "id": "banner_width_tablet",
      "label": "Banner maximum width",
      "min": 200,
      "max": 600,
      "step": 4,
      "unit": "px",
      "default": 320,
      "visible_if": "{{ section.settings.customize_tablet_layout }}"
    },
    {
      "type": "select",
      "id": "banner_ratio_tablet",
      "label": "Banner image ratio",
      "options": [
        {
          "value": "inherit",
          "label": "Use Banner block"
        },
        {
          "value": "portrait",
          "label": "Portrait (5:7)"
        }
      ],
      "default": "inherit",
      "visible_if": "{{ section.settings.customize_tablet_layout }}"
    },
    {
      "type": "range",
      "id": "overlap_tablet",
      "label": "Overlap",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.customize_tablet_layout }}"
    },
    {
      "type": "range",
      "id": "header_gap_tablet",
      "label": "Header gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.customize_tablet_layout }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 96,
      "visible_if": "{{ section.settings.customize_tablet_layout }}"
    },
    {
      "type": "checkbox",
      "id": "enable_overlap",
      "label": "Enable overlap",
      "default": false
    },
    {
      "type": "header",
      "content": "Overlap",
      "info": "Products overlap the banner horizontally on desktop/tablet and vertically on mobile.",
      "visible_if": "{{ section.settings.enable_overlap }}"
    },
    {
      "type": "range",
      "id": "overlap_desktop",
      "label": "t:options.device.desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 112,
      "visible_if": "{{ section.settings.enable_overlap }}"
    },
    {
      "type": "range",
      "id": "overlap_mobile",
      "label": "t:options.device.mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 112,
      "visible_if": "{{ section.settings.enable_overlap }}"
    },
    {
      "type": "range",
      "id": "overlap_panel_padding",
      "label": "Panel padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.enable_overlap }}"
    },
    {
      "type": "range",
      "id": "overlap_panel_padding_horizontal",
      "label": "Panel horizontal padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.enable_overlap }}"
    },
    {
      "type": "range",
      "id": "overlap_panel_max_width_mobile",
      "label": "Mobile panel maximum width",
      "info": "Set to 0 to use the container width.",
      "min": 0,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_overlap }}"
    },
    {
      "type": "select",
      "id": "overlap_panel_radius",
      "label": "Panel corner radius",
      "options": [
        {
          "value": "square",
          "label": "t:options.radius_preset.square"
        },
        {
          "value": "rounded",
          "label": "t:options.radius_preset.rounded"
        },
        {
          "value": "radius_16",
          "label": "t:options.radius_preset.size_16"
        }
      ],
      "default": "rounded",
      "visible_if": "{{ section.settings.enable_overlap }}"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:options.device.desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:options.device.mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_gap_desktop",
      "label": "Desktop header gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "header_gap_mobile",
      "label": "Mobile header gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_media_offset",
      "label": "t:labels.media_inset",
      "info": "t:info.media_offset_theme_settings",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Featured collection: Banner",
      "category": "t:general.collection",
      "settings": {
        "section_width": "page_width",
        "banner_position": "before",
        "gap_desktop": 24,
        "gap_mobile": 20,
        "color_scheme": "scheme-1",
        "padding_top": 50,
        "padding_bottom": 50,
        "customize_mobile_padding": false
      },
      "blocks": [
        {
          "type": "header",
          "id": "header",
          "static": true,
          "settings": {
            "width": "fill",
            "alignment": "center",
            "gap_desktop": 8,
            "gap_mobile": 8
          },
          "blocks": [
            {
              "type": "eyebrow",
              "settings": {
                "text": "<p>SECTION TAG</p>"
              }
            },
            {
              "type": "heading",
              "settings": {
                "text": "<p>Main Heading Text Placeholder</p>",
                "heading_size": "lg",
                "html_tag": "h2",
                "width": "fit"
              }
            }
          ]
        },
        {
          "type": "banner",
          "id": "banner",
          "static": true,
          "settings": {
            "background_type": "image",
            "show_overlay": false,
            "color_scheme": "scheme-3",
            "image_ratio_desktop": "square",
            "image_ratio_mobile": "square",
            "position_desktop": "bottom_left",
            "position_mobile": "bottom_left",
            "padding_top": 32,
            "padding_bottom": 32,
            "padding_left": 32,
            "padding_right": 32,
            "gap_desktop": 20,
            "gap_mobile": 16
          },
          "blocks": [
            {
              "type": "eyebrow",
              "settings": {
                "text": "<p>Subheading</p>"
              }
            },
            {
              "type": "heading",
              "settings": {
                "text": "<p>Your Main Heading Goes Here</p>",
                "heading_size": "lg",
                "html_tag": "h2",
                "width": "fill"
              }
            },
            {
              "type": "button",
              "settings": {
                "button_label": "Button label",
                "button_style": "tertiary",
                "width": "fit",
                "show_icon": true,
                "icon": "arrow",
                "icon_position": "after",
                "icon_size": "inherit"
              }
            }
          ]
        },
        {
          "type": "product-list",
          "id": "carousel-product-list",
          "static": true,
          "settings": {
            "collection": "",
            "max_products": 6,
            "columns_mobile": "2",
            "layout_type": "grid",
            "product_gap_desktop": 12,
            "product_gap_mobile": 8
          },
          "blocks": [
            {
              "type": "product-card",
              "id": "product-card",
              "static": true,
              "settings": {
                "color_type": "inherit",
                "color_scheme": "scheme-1"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
