{% liquid
  assign scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-1' | handleize
  assign background = section.settings.background_color | default: section.settings.color_scheme.settings.background | default: settings.color_schemes[scheme].settings.background
  assign width_class = 'page-width'
  if section.settings.section_width == 'full_width' or section.settings.section_width == 'full_bleed'
    assign width_class = 'full-width'
  endif
  assign alignment = section.settings.desktop_alignment | default: 'left'
  assign mobile_alignment = alignment
  if section.settings.customize_mobile_alignment
    assign mobile_alignment = section.settings.mobile_alignment | default: alignment
  endif
  assign flex_align = 'start'
  case alignment
    when 'center'
      assign flex_align = 'center'
    when 'right'
      assign flex_align = 'end'
  endcase
  assign mobile_flex_align = 'start'
  case mobile_alignment
    when 'center'
      assign mobile_flex_align = 'center'
    when 'right'
      assign mobile_flex_align = 'end'
  endcase
  assign padding_top = section.settings.padding_top | default: 50
  assign padding_bottom = section.settings.padding_bottom | default: 50
%}
{% capture section_style %}
  {% if background != blank %}--ce-background:{{ background }};{% endif %}
  {% if flex_align != 'start' %}--flex-align:{{ flex_align }};{% endif %}
  {% if mobile_flex_align != flex_align %}--flex-align-mobile:{{ mobile_flex_align }};{% endif %}
  {% if section.settings.gap_desktop != 30 %}--ce-section-gap:{{ section.settings.gap_desktop }}px;{% endif %}
  {% if section.settings.gap_mobile != section.settings.gap_desktop %}--ce-section-gap-mobile:{{ section.settings.gap_mobile }}px;{% endif %}
  {% if padding_top != 50 %}--section-padding-top:{{ padding_top }}px;{% endif %}
  {% if padding_bottom != 50 %}--section-padding-bottom:{{ padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if section.settings.padding_top_mobile != padding_top %}--section-padding-top-mobile:{{ section.settings.padding_top_mobile }}px;{% endif %}
    {% if section.settings.padding_bottom_mobile != padding_bottom %}--section-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% if background != blank %}{% style %}#shopify-section-{{ section.id }} { background: {{ background }}; }{% endstyle %}{% endif %}
{% render 'component-stylesheet', filename: 'component-collection-editorial.css', section_index: section.index %}
<script src="{{ 'collection-editorial.js' | asset_url }}" defer></script>
<script src="{{ 'editorial-text.js' | asset_url }}" defer></script>
<script src="{{ 'block-animations.js' | asset_url }}" defer></script>
<div class="section-spacing collection-editorial-section color-scheme section-color-scope {{ scheme }}" data-ce-section data-ce-parallax="{{ section.settings.parallax_effect }}" data-ce-divider-top="{{ section.settings.show_top_divider }}" data-ce-divider-bottom="{{ section.settings.show_bottom_divider }}" data-ce-align="{{ alignment }}" data-ce-align-mobile="{{ mobile_alignment }}" style="{{ section_style | strip }}">
  {% if section.settings.background_media != 'none' %}<div class="ce-background" aria-hidden="true">{% render 'media-background', media_type: section.settings.background_media, image: section.settings.background_image, mobile_image: section.settings.background_image_mobile, video: section.settings.background_video, alt: '', aria_hidden: true, sizes: '100vw' %}{% if section.settings.background_overlay %}<div class="ce-background__overlay" style="background:{{ section.settings.background_overlay_color }}"></div>{% endif %}</div>{% endif %}
  <div class="container {{ width_class }} ce-section-stack{% if section.settings.section_width == 'full_bleed' %} ce-full-bleed{% endif %}">
    {% content_for 'block', type: '_collection-editorial-header', id: 'header' %}
    {% content_for 'block', type: '_collection-editorial-action', id: 'view-all' %}
    {% content_for 'block', type: '_collection-editorial-list', id: 'collection-list' %}
  </div>
</div>
{% schema %}
{
  "name": "t:collection_editorial.name",
  "class": "section-collection-list-editorial",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Select collections in the 'Collection list' block"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        },
        {
          "value": "full_bleed",
          "label": "Full width (no padding)"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "text_alignment",
      "id": "desktop_alignment",
      "label": "t:labels.alignment",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_alignment",
      "label": "t:labels.customize_mobile_alignment",
      "default": false
    },
    {
      "type": "text_alignment",
      "id": "mobile_alignment",
      "label": "t:labels.mobile_alignment",
      "default": "left",
      "visible_if": "{{ section.settings.customize_mobile_alignment }}"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.desktop_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "alpha": true
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "Background media",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Mobile background image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "t:labels.background_video",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "background_overlay",
      "label": "t:labels.show_overlay",
      "visible_if": "{{ section.settings.background_media != 'none' }}",
      "default": true
    },
    {
      "type": "color",
      "id": "background_overlay_color",
      "label": "t:labels.overlay_color",
      "visible_if": "{{ section.settings.background_media != 'none' and section.settings.background_overlay }}",
      "default": "#000000",
      "alpha": true
    },
    {
      "type": "select",
      "id": "parallax_effect",
      "label": "Parallax effect",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fixed",
          "label": "Fixed"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ],
      "visible_if": "{{ section.settings.background_media != 'none' }}",
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "show_top_divider",
      "label": "t:labels.show_top_divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_divider",
      "label": "t:labels.show_bottom_divider",
      "default": false
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "visible_if": "{{ section.settings.customize_mobile_padding }}",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "visible_if": "{{ section.settings.customize_mobile_padding }}",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:collection_editorial.name",
      "blocks": [
        {
          "type": "_collection-editorial-header",
          "id": "header",
          "static": true,
          "blocks": [
            {
              "type": "_collection-editorial-subheading",
              "settings": {
                "text": "Shop by category",
                "show_icon": true,
                "icon": "square",
                "animation_type": "slide-bottom",
                "animation_delay": 200
              }
            }
          ]
        },
        {
          "type": "_collection-editorial-action",
          "id": "view-all",
          "static": true
        },
        {
          "type": "_collection-editorial-list",
          "id": "collection-list",
          "static": true,
          "blocks": [
            {
              "type": "_collection-editorial-item"
            },
            {
              "type": "_collection-editorial-item"
            },
            {
              "type": "_collection-editorial-item"
            },
            {
              "type": "_collection-editorial-item"
            },
            {
              "type": "_collection-editorial-item"
            },
            {
              "type": "_collection-editorial-item"
            },
            {
              "type": "_collection-editorial-item"
            },
            {
              "type": "_collection-editorial-item"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
