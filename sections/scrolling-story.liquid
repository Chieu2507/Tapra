{% liquid
  assign width_class = 'page-width'
  if section.settings.section_width != 'page_width'
    assign width_class = 'full-width'
  endif
%}
{% render 'component-stylesheet', filename: 'component-scrolling-story.css', section_index: section.index %}
<script src="{{ 'scrolling-story.js' | asset_url }}" defer="defer"></script>
<div class="section-spacing scrolling-story color-scheme section-color-scope {{ section.settings.color_scheme }}{% if section.settings.surface_light %} scrolling-story--surface{% endif %}" style="--section-padding-top:{{ section.settings.padding_top }}px;--section-padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.customize_mobile_padding %}--section-padding-top-mobile:{{ section.settings.padding_top_mobile }}px;--section-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile }}px;{% endif %}--story-header-gap:{{ section.settings.header_gap }}px;--story-header-gap-mobile:{{ section.settings.header_gap_mobile }}px;--story-media-width-mobile:{{ section.settings.media_width_mobile }}px;--story-top-mobile:{{ section.settings.sticky_top_mobile }}px;--story-media-width:{{ section.settings.media_width }}px;--story-gap:{{ section.settings.column_gap }}px;--story-step-height:{{ section.settings.step_height }}svh;--story-top:{{ section.settings.sticky_top }}px;">
  <div class="container {{ width_class }}{% if section.settings.section_width == 'full_bleed' %} scrolling-story--full-bleed{% endif %}">
    <div class="scrolling-story__header">{% content_for 'block', type: 'group', id: 'header' %}</div>
    <scrolling-story class="scrolling-story__steps" data-animate="{{ section.settings.animate }}" data-pagination="{{ section.settings.show_pagination }}" data-pagination-mobile="{{ section.settings.show_pagination_mobile }}" role="region" aria-label="{{ section.settings.aria_label | escape }}">
      {% content_for 'blocks' %}
    </scrolling-story>
  </div>
</div>
{% schema %}
{
  "name": "t:scrolling_story.name",
  "tag": "section",
  "class": "section-scrolling-story",
  "max_blocks": 6,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_scrolling-story-step"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "Page width"
