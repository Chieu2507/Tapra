{% doc %}
  @param {number} [placeholder_index] - Ordered placeholder image variant
  Renders a Product Card from the product context supplied by its parent
  Product List, section, grid, or recommendation surface.

  The card's baseline presentation is managed by Theme Settings → Product
  cards. This block only exposes instance-level controls defined by the
  Commerce Block contract.

  @param {product} [product] - Product resource supplied by the parent list
  @param {boolean} [placeholder] - Whether to render the shared empty card state
  @param {string} [color_type_override] - Internal parent override for legacy card settings
  @param {object} [color_scheme_override] - Internal parent override for legacy card settings
  @param {string} [editor_attributes_override] - Internal parent override for legacy editor attributes

  A parent may pass `placeholder: true` while a product resource is not
  available so the card can preserve the parent layout in the editor and
  storefront preview.

  @example
  {% content_for 'block', type: 'product-card', id: 'product-card' %}
{% enddoc %}

{% liquid
  assign product_card_media_inset = nil
  if block.settings.customize_media_inset
    assign product_card_media_inset = block.settings.media_inset | default: 0 | at_least: 0 | at_most: 32
  endif
  assign card_product = closest.product | default: product
  assign product_card_color_type = block.settings.color_type
  if color_type_override != nil
    assign product_card_color_type = color_type_override
  endif
  assign product_card_color_scheme = block.settings.color_scheme
  if color_scheme_override != nil
    assign product_card_color_scheme = color_scheme_override
  endif
  assign product_card_editor_attributes = block.shopify_attributes
  if editor_attributes_override != blank
    assign product_card_editor_attributes = editor_attributes_override
  endif
%}

{% capture product_card_rating %}
  {% if card_product != blank and block.settings.show_rating %}
    {% content_for 'block', type: 'product-rating', id: 'rating', closest.product: card_product %}
  {% endif %}
{% endcapture %}
{% assign product_card_rating = product_card_rating | strip %}

{% if card_product != blank %}
  {% render 'product-card',
    product: card_product,
    rating_content: product_card_rating,
    card_style: block.settings.card_style,
    media_corner_radius: block.settings.media_corner_radius,
    media_ratio: block.settings.media_ratio,
    media_inset: product_card_media_inset,
    color_type: product_card_color_type,
    color_scheme: product_card_color_scheme,
    attributes: product_card_editor_attributes
  %}
{% elsif placeholder %}
  {% render 'product-card',
    product: blank,
    placeholder: true,
    placeholder_index: placeholder_index,
    card_style: block.settings.card_style,
    media_corner_radius: block.settings.media_corner_radius,
    media_ratio: block.settings.media_ratio,
    media_inset: product_card_media_inset,
    color_type: product_card_color_type,
    color_scheme: product_card_color_scheme,
    attributes: product_card_editor_attributes
  %}
{% else %}
  <div class="product-card product-card--empty" {{ product_card_editor_attributes }}>
    <p class="product-card__empty-message body-sm">{{ 'products.no_product' | t }}</p>
  </div>
{% endif %}

{% stylesheet %}
  .product-card--empty:not(.product-card--placeholder) {
    display: grid;
    min-height: 8rem;
    place-items: center;
    padding: 1rem;
  }

  .product-card__empty-message {
    color: color-mix(in srgb, var(--body-color) 70%, transparent);
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
