{% render 'collection-editorial-content', block: block, role: 'subheading' %}
{% schema %}
{
  "name": "Subheading",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Shop by category"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Color",
      "options": [
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "text",
          "label": "Text"
        }
      ],
      "default": "heading"
    },
    {
      "type": "checkbox",
      "id": "show_background",
      "label": "Show background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": false
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "diamond",
          "label": "Diamond"
        },
        {
          "value": "sparkle",
          "label": "Sparkle"
        },
        {
          "value": "line",
          "label": "Line"
        }
      ],
      "visible_if": "{{ block.settings.show_icon }}",
      "default": "square"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "Type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "scale",
          "label": "Scale"
        },
        {
          "value": "slide-left",
          "label": "Slide from left"
        },
        {
          "value": "slide-right",
          "label": "Slide from right"
        },
        {
          "value": "slide-bottom",
          "label": "Slide from bottom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "Delay",
      "min": 0,
      "max": 2000,
      "step": 50,
      "unit": "ms",
      "visible_if": "{{ block.settings.animation_type != 'none' }}",
      "default": 250
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "Custom for mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.settings.customize_mobile_padding }}",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.settings.customize_mobile_padding }}",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Subheading"
    }
  ]
}
{% endschema %}
