      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:labels.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:labels.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:labels.mobile_left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:labels.mobile_right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.image_card",
      "category": "t:general.cards",
      "settings": {
        "padding_top": 32,
        "padding_bottom": 32,
        "padding_left": 32,
        "padding_right": 32
      },
      "blocks": [
        {
          "type": "eyebrow",
          "settings": {
            "text": "<p>Eyebrow</p>"
          }
        },
        {
          "type": "heading",
          "settings": {
            "text": "<p>Heading</p>",
            "heading_size": "lg",
            "html_tag": "h2"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Button label",
            "button_style": "primary",
            "button_open_in_new_tab": false,
            "show_icon": false,
            "icon": "arrow",
            "icon_position": "after",
            "icon_size": "inherit",
            "icon_width": 20,
            "width": "fit",
            "width_mobile": "fit",
            "customize_mobile_padding": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
