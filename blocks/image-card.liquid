{% doc %}
  Renders a media-led card with a responsive background and controlled content blocks.

  The block owns its media, link, size, content position, gap, appearance and
  padding.
  Child blocks own their content and inherit alignment from the card.

  @example
  {% content_for 'block', type: 'image-card', id: 'image-card' %}
{% enddoc %}

{% capture card_content %}{% content_for 'blocks' %}{% endcapture %}
{% render 'image-card-content', block: block, content: card_content %}
{% schema %}
{
  "name": "t:general.image_card",
  "tag": null,
  "blocks": [
    {
      "type": "blog-card-title"
    },
    {
      "type": "blog-card-meta"
    },
    {
      "type": "blog-card-button"
    },
    {
      "type": "eyebrow"
    },
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "icon"
    },
    {
      "type": "header"
    },
    {
      "type": "group"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:labels.open_in_new_tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:labels.background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:labels.type",
      "options": [
        {
          "value": "none",
          "label": "t:options.image_card_media.none"
        },
        {
          "value": "image",
          "label": "t:general.image"
        },
        {
          "value": "video",
          "label": "t:general.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "visible_if": "{{ block.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:labels.mobile_image",
      "visible_if": "{{ block.settings.background_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video",
      "visible_if": "{{ block.settings.background_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "t:labels.mobile_video",
      "visible_if": "{{ block.settings.background_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "zoom_on_hover",
      "label": "Zoom image on hover",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "t:labels.show_overlay",
      "default": false
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:labels.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.overlay_style.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.overlay_style.gradient"
        }
      ],
      "default": "gradient",
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:labels.overlay_color",
      "alpha": true,
      "default": "#00000033",
      "visible_if": "{{ block.settings.show_overlay and block.settings.overlay_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "label": "t:labels.overlay_gradient",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.52))",
      "visible_if": "{{ block.settings.show_overlay and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:general.size"
    },
    {
      "type": "select",
      "id": "device",
      "label": "t:labels.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "select",
      "id": "width_desktop",
      "label": "t:labels.width",
      "options": [
        {
          "value": "fill",
          "label": "t:options.width.fill"
        },
        {
          "value": "custom",
          "label": "t:options.width.custom"
        }
      ],
      "default": "fill",
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "width_custom_desktop",
      "label": "t:labels.desktop_custom_width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.device == 'desktop' and block.settings.width_desktop == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "limit_width_desktop",
      "label": "t:labels.limit_width",
      "default": false,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "max_width_desktop",
      "label": "t:labels.max_width",
      "min": 0,
      "max": 1600,
      "step": 16,
      "unit": "px",
      "default": 1600,
      "visible_if": "{{ block.settings.device == 'desktop' and block.settings.limit_width_desktop }}"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "t:labels.height",
      "options": [
        {
          "value": "fill",
          "label": "t:options.width.fill"
        },
        {
          "value": "ratio_1_1",
          "label": "t:options.image_card_height.ratio_1_1"
        },
        {
          "value": "ratio_6_7",
          "label": "6:7"
        },
        {
          "value": "ratio_4_5",
          "label": "t:options.image_card_height.ratio_4_5"
        },
        {
          "value": "ratio_3_2",
          "label": "t:options.image_card_height.ratio_3_2"
        },
        {
          "value": "ratio_4_3",
          "label": "t:options.image_card_height.ratio_4_3"
        },
        {
          "value": "ratio_16_9",
          "label": "t:options.image_card_height.ratio_16_9"
        },
        {
          "value": "ratio_2_3",
          "label": "t:options.image_card_height.ratio_2_3"
        },
        {
          "value": "ratio_3_4",
          "label": "t:options.image_card_height.ratio_3_4"
        },
        {
          "value": "ratio_9_16",
          "label": "t:options.image_card_height.ratio_9_16"
        }
      ],
      "default": "ratio_1_1",
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:labels.width",
      "options": [
        {
          "value": "fill",
          "label": "t:options.width.fill"
        },
        {
          "value": "custom",
          "label": "t:options.width.custom"
        }
      ],
      "default": "fill",
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "width_custom_mobile",
      "label": "t:labels.mobile_custom_width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.device == 'mobile' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "limit_width_mobile",
      "label": "t:labels.limit_width",
      "default": false,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "max_width_mobile",
      "label": "t:labels.max_width",
      "min": 0,
      "max": 1600,
      "step": 16,
      "unit": "px",
      "default": 1600,
      "visible_if": "{{ block.settings.device == 'mobile' and block.settings.limit_width_mobile }}"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "t:labels.height",
      "options": [
        {
          "value": "fill",
          "label": "t:options.width.fill"
        },
        {
          "value": "ratio_1_1",
          "label": "t:options.image_card_height.ratio_1_1"
        },
        {
          "value": "ratio_6_7",
          "label": "6:7"
        },
        {
          "value": "ratio_4_5",
          "label": "t:options.image_card_height.ratio_4_5"
        },
        {
          "value": "ratio_3_2",
          "label": "t:options.image_card_height.ratio_3_2"
        },
        {
          "value": "ratio_4_3",
          "label": "t:options.image_card_height.ratio_4_3"
        },
        {
          "value": "ratio_16_9",
          "label": "t:options.image_card_height.ratio_16_9"
        },
        {
          "value": "ratio_2_3",
          "label": "t:options.image_card_height.ratio_2_3"
        },
        {
          "value": "ratio_3_4",
          "label": "t:options.image_card_height.ratio_3_4"
        },
        {
          "value": "ratio_9_16",
          "label": "t:options.image_card_height.ratio_9_16"
        }
      ],
      "default": "ratio_1_1",
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:labels.enable_sticky",
      "default": true
    },
    {
      "type": "select",
      "id": "position_desktop",
      "label": "t:labels.desktop_position",
      "options": [
        {
          "value": "top_left",
          "label": "Top left"
        },
        {
          "value": "top_center",
          "label": "Top center"
        },
        {
          "value": "top_right",
          "label": "Top right"
        },
        {
          "value": "center_left",
          "label": "Center left"
        },
        {
          "value": "center_center",
          "label": "Center center"
        },
        {
          "value": "center_right",
          "label": "Center right"
        },
        {
          "value": "bottom_left",
          "label": "Bottom left"
        },
        {
          "value": "bottom_center",
          "label": "Bottom center"
        },
        {
          "value": "bottom_right",
          "label": "Bottom right"
        }
      ],
      "default": "top_center"
    },
    {
      "type": "select",
      "id": "position_mobile",
      "label": "t:labels.mobile_position",
      "options": [
        {
          "value": "top_left",
          "label": "Top left"
        },
        {
          "value": "top_center",
          "label": "Top center"
        },
        {
          "value": "top_right",
          "label": "Top right"
        },
        {
          "value": "center_left",
          "label": "Center left"
        },
        {
          "value": "center_center",
          "label": "Center center"
        },
        {
          "value": "center_right",
          "label": "Center right"
        },
        {
          "value": "bottom_left",
          "label": "Bottom left"
        },
        {
          "value": "bottom_center",
          "label": "Bottom center"
        },
        {
          "value": "bottom_right",
          "label": "Bottom right"
        }
      ],
      "default": "top_center"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.desktop_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:general.border"
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "t:labels.corner_radius",
      "options": [
        {
          "value": "square",
          "label": "t:options.radius_preset.square"
        },
        {
          "value": "radius_2",
          "label": "t:options.radius_preset.size_2"
        },
        {
          "value": "slightly_rounded",
          "label": "t:options.radius_preset.slightly_rounded"
        },
        {
          "value": "radius_4",
          "label": "t:options.radius_preset.size_4"
        },
        {
          "value": "radius_6",
          "label": "t:options.radius_preset.size_6"
        },
        {
          "value": "rounded",
          "label": "t:options.radius_preset.rounded"
        },
        {
          "value": "radius_8",
          "label": "t:options.radius_preset.size_8"
        },
        {
          "value": "radius_12",
          "label": "t:options.radius_preset.size_12"
        },
        {
          "value": "radius_16",
          "label": "t:options.radius_preset.size_16"
        },
        {
          "value": "radius_24",
          "label": "t:options.radius_preset.size_24"
        },
        {
          "value": "radius_32",
          "label": "t:options.radius_preset.size_32"
        },
        {
          "value": "pill",
          "label": "t:options.radius_preset.pill"
        }
      ],
      "default": "square"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "Type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "scale", "label": "Scale" },
        { "value": "slide-left", "label": "Slide from left" },
        { "value": "slide-right", "label": "Slide from right" },
        { "value": "slide-bottom", "label": "Slide from bottom" }
      ],
      "default": "slide-bottom"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "Delay",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
