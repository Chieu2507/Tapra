        },
        {
          "value": "play",
          "label": "Play"
        },
        {
          "value": "pause",
          "label": "Pause"
        },
        {
          "value": "plus",
          "label": "Plus"
        },
        {
          "value": "minus",
          "label": "Minus"
        },
        {
          "value": "check",
          "label": "Check"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "triangle",
