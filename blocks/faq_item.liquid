        },
        {
          "value": "chevron",
          "label": "Chevron"
        },
        {
          "value": "chevron-down",
          "label": "Chevron down"
        },
        {
          "value": "chevron-left",
          "label": "Chevron left"
        },
        {
          "value": "chevron-right",
          "label": "Chevron right"
        },
        {
          "value": "x-mark",
          "label": "Close"
        },
        {
          "value": "magnifying-glass",
          "label": "Search"
        },
        {
          "value": "shopping-bag",
          "label": "Shopping bag"
        },
        {
          "value": "cart",
          "label": "Cart"
        },
        {
