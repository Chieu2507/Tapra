{% doc %}
  Renders a Gallery image as a social overlay or an editable post card.
  Post content is merchant-authored, including displayed likes; it is not a live Instagram feed.
  Image, profile, badges and surface settings remain independent of the owning Gallery layout.
{% enddoc %}
{% capture effective_overlay %}{% render 'overlay-background', overlay_settings: block.settings, color_id: 'overlay_background', enabled_id: 'enable_overlay', style_id: 'background_overlay_style' %}{% endcapture %}
{% assign effective_overlay = effective_overlay | strip %}
{% liquid
  assign tag = block.settings.tag
  assign overlay_style = block.settings.overlay_style | default: 'button'
  assign image_radius = 'var(--media-radius, 0px)'
  if block.settings.corner_radius contains 'radius_'
    assign image_radius = block.settings.corner_radius | replace: 'radius_', 'var(--radius-' | append: ', 0px)'
  endif
  if block.settings.corner_radius == 'custom'
    assign image_radius = block.settings.custom_corner_radius | default: 18 | append: 'px'
  endif
  case block.settings.corner_radius
    when 'square', 'radius_0'
      assign image_radius = 'var(--radius-square)'
    when 'rounded'
      assign image_radius = 'var(--radius-rounded)'
    when 'full'
      assign image_radius = 'var(--radius-pill)'
  endcase
  assign image_sizes = '(min-width: 768px) 25vw, 50vw'
  if section.type == 'gallery-carousel' and section.settings.section_width == 'page_width'
    assign image_sizes = '(min-width: 1150px) 280px, 256px'
  elsif section.settings.section_width == 'full_width'
    assign image_sizes = '(min-width: 1150px) 20vw, 256px'
  endif
  assign social_network = block.settings.social_network | default: 'instagram'
  assign social_url = block.settings.social_url
  if social_url == blank
    assign social_setting_key = 'social_' | append: social_network
    assign social_url = settings[social_setting_key]
  endif
  assign show_overlay = block.settings.show_overlay | default: 'always'
  unless show_overlay == 'always' or show_overlay == 'hover'
    assign show_overlay = 'always'
  endunless
  assign social_background = block.settings.social_background | default: '#FFFFFF'
  assign social_color = block.settings.social_color | default: '#6A372F'
  assign overlay_background = effective_overlay | default: 'transparent'
  assign tag_font_size = block.settings.tag_font_size | default: 'md'
  assign customize_mobile_tag_font_size = block.settings.customize_mobile_tag_font_size
  assign tag_font_size_mobile = block.settings.tag_font_size_mobile | default: tag_font_size
  assign tag_font_size_token = 'var(--font-body-md)'
  case tag_font_size
    when 'xs'
      assign tag_font_size_token = 'var(--font-body-xs)'
    when 'sm'
      assign tag_font_size_token = 'var(--font-body-sm)'
    when 'lg'
      assign tag_font_size_token = 'var(--font-body-lg)'
    when 'custom'
      assign tag_font_size_token = block.settings.tag_font_size_custom | default: 16 | append: 'px'
  endcase
  assign tag_font_size_mobile_token = tag_font_size_token
  if customize_mobile_tag_font_size
    case tag_font_size_mobile
      when 'xs'
        assign tag_font_size_mobile_token = 'var(--font-body-xs)'
      when 'sm'
        assign tag_font_size_mobile_token = 'var(--font-body-sm)'
      when 'md'
        assign tag_font_size_mobile_token = 'var(--font-body-md)'
      when 'lg'
        assign tag_font_size_mobile_token = 'var(--font-body-lg)'
      when 'custom'
        assign tag_font_size_mobile_token = block.settings.tag_font_size_custom_mobile | default: 14 | append: 'px'
    endcase
  endif
%}

{% assign gallery_ratio_fallback = block.settings.image_ratio %}
{% if gallery_ratio_fallback == 'auto' or gallery_ratio_fallback == blank %}{% assign gallery_ratio_fallback = block.settings.image.aspect_ratio | default: 1 %}{% endif %}
{% capture gallery_ratio %}{% render 'image-ratio-value', setting: block.settings.image_ratio, fallback_ratio: gallery_ratio_fallback, custom_width: block.settings.image_ratio_custom_width, custom_height: block.settings.image_ratio_custom_height %}{% endcapture %}
<div data-marquee-interactive class="gallery-image{% if overlay_style == 'post' %} gallery-image--post{% endif %} gallery-image--overlay-{{ show_overlay }} gallery-image--style-{{ overlay_style }}" style="--gallery-image-ratio: {{ gallery_ratio | strip }}; --gallery-post-padding: {{ block.settings.card_padding | default: 6 }}px; --gallery-post-background: {{ block.settings.background_color | default: 'var(--background-color)' }}; --gallery-post-border: {{ block.settings.border_width | default: 1 }}px; --gallery-post-border-color: {{ block.settings.border_color | default: 'var(--border-color)' }}; --gallery-post-media-radius: {{ block.settings.media_radius | default: 12 }}px; --gallery-post-text: {{ block.settings.text_color | default: 'var(--body-color)' }}; --gallery-post-like-color: {{ block.settings.likes_hover_color | default: 'var(--accent-color)' }}; --gallery-post-like-background: {{ block.settings.likes_hover_background | default: 'transparent' }}; --gallery-image-radius: {{ image_radius }};     --gallery-social-background: {{ social_background | escape }}; --gallery-social-color: {{ social_color | escape }}; --gallery-overlay-background: {{ overlay_background | escape }}; --gallery-tag-font-size: {{ tag_font_size_token }}; --gallery-tag-font-size-mobile: {{ tag_font_size_mobile_token }};" {{ block.shopify_attributes }}>
  <div class="gallery-image__visual">
  {% render 'image', image: block.settings.image, mobile_image: block.settings.mobile_image, alt: block.settings.alt_text, class: 'gallery-image__media', width: 1600, widths: '400, 600, 800, 1200, 1600', sizes: image_sizes %}
  {% if overlay_style == 'post' %}
    {% if block.settings.badge_left != blank %}<span class="gallery-image__badge gallery-image__badge--left">{{ block.settings.badge_left | escape }}</span>{% endif %}
    {% if block.settings.badge_right != blank %}<span class="gallery-image__badge gallery-image__badge--right">{{ block.settings.badge_right | escape }}</span>{% endif %}
  {% endif %}
  </div>
  {% if overlay_style == 'post' %}
    {% if tag != blank or block.settings.avatar_image != blank or block.settings.avatar_initials != blank or block.settings.show_likes %}
    <div class="gallery-image__profile">
      {% if block.settings.avatar_image != blank %}
        {{ block.settings.avatar_image | image_url: width: 80 | image_tag: class: 'gallery-image__avatar', loading: 'lazy', alt: '' }}
      {% elsif block.settings.avatar_initials != blank %}
        <span class="gallery-image__avatar gallery-image__avatar--initials" aria-hidden="true">{{ block.settings.avatar_initials | escape }}</span>
      {% endif %}
      {% if tag != blank %}
        {% if social_url != blank %}<a class="gallery-image__username link-underline" href="{{ social_url | escape }}" target="_blank" rel="noopener noreferrer">{{ tag | escape }}</a>{% else %}<span class="gallery-image__username">{{ tag | escape }}</span>{% endif %}
      {% endif %}
      {% if block.settings.show_likes %}
        <span class="gallery-image__likes" aria-label="{{ 'gallery.likes' | t: count: block.settings.likes_count | escape }}">
          {% capture gallery_like_icon %}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.5 8.2 3.4 5 6.6 5c1.9 0 3.5 1 5.4 3 1.9-2 3.5-3 5.4-3 3.2 0 5.1 3.2 3.9 6.3-1.8 4.6-9.3 9.2-9.3 9.2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>{% endcapture %}
          {% render 'icon', source: 'custom', custom_icon: gallery_like_icon, width: 14 %}
          <span>{{ block.settings.likes_count | escape }}</span>
        </span>
      {% endif %}
    </div>
    {% endif %}
  {% else %}
  <div class="gallery-image__overlay">
    {% unless social_network == 'none' %}
      {% if social_url != blank %}<a class="gallery-image__button" href="{{ social_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ tag | default: social_network | escape }}">{% else %}<span class="gallery-image__button">{% endif %}
        {% if overlay_style == 'minimal' and social_network == 'instagram' %}
          <img src="{{ 'perky-gallery-instagram.svg' | asset_url }}" width="24" height="24" alt="" loading="lazy">
        {% else %}
        {% case social_network %}
        {% when 'facebook' %}<svg class="gallery-image__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10H8v3h2.6v8h2.9Z"/></svg>
        {% when 'x' %}<svg class="gallery-image__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 4h4.2l3.1 4.3L16 4h2.7l-5.1 5.8L19 20h-4.2l-3.5-4.9L7.1 20H4.4l5.4-6.4L5 4Zm3.1 2 7.7 12h1.1L9.2 6H8.1Z"/></svg>
        {% when 'tiktok' %}<svg class="gallery-image__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 4h2.4c.2 1.5 1.1 2.8 2.6 3.5v2.5a7 7 0 0 1-2.6-1V15a5 5 0 1 1-5-5h.5v2.6a2.5 2.5 0 1 0 1.9 2.4V4Z"/></svg>
        {% when 'youtube' %}<svg class="gallery-image__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 8.1a2.5 2.5 0 0 0-1.8-1.8C17.6 6 12 6 12 6s-5.6 0-7.2.3A2.5 2.5 0 0 0 3 8.1 26 26 0 0 0 2.7 12c0 1.3.1 2.7.3 3.9a2.5 2.5 0 0 0 1.8 1.8c1.6.3 7.2.3 7.2.3s5.6 0 7.2-.3a2.5 2.5 0 0 0 1.8-1.8c.2-1.2.3-2.6.3-3.9s-.1-2.7-.3-3.9ZM10 15.5v-7l6 3.5-6 3.5Z"/></svg>
        {% when 'pinterest' %}<svg class="gallery-image__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="currentColor"/><path fill="var(--gallery-social-background, #fff)" d="M12.4 6.4c-2.7 0-4.3 1.8-4.3 3.8 0 1.1.4 2.1 1.1 2.5.1.1.2.1.2-.1l.3-1.1c0-.1 0-.2-.1-.3-.2-.3-.4-.8-.4-1.3 0-1.2.9-2.3 2.8-2.3 1.5 0 2.5.9 2.5 2.2 0 1.6-.7 2.9-1.8 2.9-.6 0-1.1-.5-.9-1.1.2-.7.6-1.5.6-2 0-.5-.3-.9-.8-.9-.6 0-1 .6-1 1.4 0 .5.2.8.2.8l-.8 3.3c-.2 1-.3 2.1-.1 3 .1.1.1.1.2 0 .3-.4.8-1.5 1-2.4l.3-1.1c.3.6 1 .9 1.7.9 2.2 0 3.7-2 3.7-4.8 0-2.1-1.8-3.7-4.4-3.7Z"/></svg>
        {% when 'linkedin' %}<svg class="gallery-image__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 8.5A1.5 1.5 0 1 1 5 5.5a1.5 1.5 0 0 1 0 3ZM3.7 10h2.6v8H3.7v-8Zm4.2 0h2.5v1.1h.1c.3-.6 1.2-1.4 2.6-1.4 2.8 0 3.3 1.8 3.3 4.1V18h-2.6v-3.7c0-.9 0-2.1-1.3-2.1s-1.5 1-1.5 2V18H7.9v-8Z"/></svg>
        {% else %}<svg class="gallery-image__icon" viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4.25" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>
        {% endcase %}
        {% endif %}
      {% if social_url != blank %}</a>{% else %}</span>{% endif %}
    {% endunless %}
    {% if tag != blank %}<span class="gallery-image__tag">{{ tag | escape }}</span>{% endif %}
  </div>
  {% endif %}
</div>

{% render 'component-stylesheet', filename: 'component-blocks-gallery-image.css', section_index: section.index %}

{% schema %}
{
