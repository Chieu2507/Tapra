  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Alt text"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "default": "square",
      "options": [
        {
          "value": "auto",
          "label": "t:options.image_ratio.auto"
        },
        {
          "value": "square",
          "label": "t:options.image_ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:options.image_ratio.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.image_ratio.landscape"
        },
        {
          "value": "ratio_7_6",
          "label": "t:options.image_ratio.ratio_7_6"
        },
        {
          "value": "wide",
          "label": "t:options.image_ratio.wide"
        },
        {
          "value": "custom",
          "label": "t:options.image_ratio.custom"
        }
      ]
    },
    {
      "type": "number",
      "id": "image_ratio_custom_width",
      "label": "W",
      "default": 3,
      "visible_if": "{{ block.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_height",
      "label": "H",
      "default": 4,
      "visible_if": "{{ block.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "t:labels.corner_radius",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.radius_preset.inherit"
        },
        {
          "value": "square",
          "label": "t:options.radius_preset.square"
        },
        {
          "value": "radius_2",
          "label": "t:options.radius_preset.size_2"
        },
        {
          "value": "radius_4",
          "label": "t:options.radius_preset.size_4"
        },
        {
          "value": "radius_6",
          "label": "t:options.radius_preset.size_6"
        },
        {
          "value": "rounded",
          "label": "t:options.radius_preset.rounded"
        },
        {
          "value": "radius_8",
          "label": "t:options.radius_preset.size_8"
        },
        {
          "value": "radius_12",
          "label": "t:options.radius_preset.size_12"
        },
        {
          "value": "radius_16",
          "label": "t:options.radius_preset.size_16"
        },
        {
          "value": "radius_24",
          "label": "t:options.radius_preset.size_24"
        },
        {
          "value": "radius_32",
          "label": "t:options.radius_preset.size_32"
        },
        {
          "value": "full",
          "label": "t:options.radius_preset.full"
        },
        {
          "value": "custom",
          "label": "t:options.radius_preset.custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "custom_corner_radius",
      "label": "t:gallery_extension.label_custom_corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18,
      "visible_if": "{{ block.settings.corner_radius == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Social content style",
      "options": [
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "minimal",
          "label": "Icon and text"
        },
        {
          "value": "post",
          "label": "t:gallery_extension.label_post"
        }
      ],
      "default": "button"
    },
    {
      "type": "text",
