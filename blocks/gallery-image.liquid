      "visible_if": "{{ block.settings.overlay_style == 'post' }}"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "select",
      "id": "show_overlay",
      "label": "Show social overlay",
      "options": [
