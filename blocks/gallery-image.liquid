      "alpha": true,
      "visible_if": "{{ block.settings.overlay_style == 'post' }}"
    },
    {
      "type": "color",
      "id": "likes_hover_color",
      "label": "t:gallery_extension.label_likes_hover_color",
      "visible_if": "{{ block.settings.overlay_style == 'post' }}"
    },
    {
      "type": "color",
      "id": "likes_hover_background",
      "label": "t:gallery_extension.label_likes_hover_background",
