{% doc %}
  Fixed Editorial list slot; owns row appearance and semantic title tags.
{% enddoc %}
{% liquid
  assign radius = 'var(--container-radius, var(--radius-rounded))'
  case block.settings.corner_radius
    when 'square', 'none'
      assign radius = 'var(--radius-square)'
    when 'radius_2', 'radius_4', 'radius_6', 'radius_8', 'radius_12', 'radius_16', 'radius_24', 'radius_32'
      assign radius = block.settings.corner_radius | replace: 'radius_', 'var(--radius-' | append: ')'
    when 'rounded'
      assign radius = 'var(--radius-rounded)'
    when 'full'
      assign radius = 'var(--radius-pill)'
    when 'xl'
      assign radius = 'var(--radius-extra, 24px)'
    when 'custom'
      assign radius = block.settings.custom_corner_radius | default: 0 | at_least: 0 | at_most: 40 | append: 'px'
  endcase
%}
{% capture desktop_size %}{% render 'heading-size-token', size: block.settings.heading_size, fallback: 'xl' %}{% endcapture %}
{% capture mobile_size %}{% render 'heading-size-token', size: block.settings.heading_size_mobile, fallback: 'sm' %}{% endcapture %}
<div class="ce-list" data-ce-count="{{ block.settings.show_product_count }}" data-ce-navigation="{{ block.settings.show_navigation_icon }}" data-ce-background="{{ block.settings.show_background }}" data-ce-shadow="{{ block.settings.shadow }}" style="--ce-columns:{{ block.settings.columns_desktop }};--ce-columns-mobile:{{ block.settings.columns_mobile }};--ce-gap:{{ block.settings.gap_desktop }}px;--ce-gap-mobile:{{ block.settings.gap_mobile }}px;--ce-radius:{{ radius }};--ce-border:{{ block.settings.border_width }}px;--ce-row-block:{{ block.settings.padding_block }}px;--ce-row-inline:{{ block.settings.padding_inline }}px;--ce-row-block-mobile:{{ block.settings.padding_block_mobile }}px;--ce-row-inline-mobile:{{ block.settings.padding_inline_mobile }}px;{% if desktop_size == 'custom' %}--ce-title-size:{{ block.settings.custom_heading_size | default: 24 | at_least: 10 | at_most: 100 }}px;{% else %}--ce-title-size:var(--font-heading-{{ desktop_size | strip }});{% endif %}--ce-title-lh:var(--font-heading-{{ desktop_size | strip }}-line-height);--ce-title-case:var(--font-heading-{{ desktop_size | strip }}-text-transform);{% if mobile_size == 'custom' %}--ce-title-size-mobile:{{ block.settings.custom_heading_size_mobile | default: 24 | at_least: 10 | at_most: 100 }}px;{% else %}--ce-title-size-mobile:var(--font-heading-{{ mobile_size | strip }});{% endif %}--ce-title-lh-mobile:var(--font-heading-{{ mobile_size | strip }}-line-height);--ce-title-case-mobile:var(--font-heading-{{ mobile_size | strip }}-text-transform);" {{ block.shopify_attributes }}>
  {% comment %}Resolve child title markers here so the parent owns semantics in server HTML, without passing unsupported settings through content_for blocks.{% endcomment %}
  {% capture items %}{% content_for 'blocks' %}{% endcapture %}
  {% liquid
    assign title_tag = block.settings.html_tag | default: 'div'
    assign open_tag = '<' | append: title_tag | append: ' class="ce-item__title"'
    assign close_tag = '</' | append: title_tag | append: '>'
    echo items | replace: '<ce-title-tag class="ce-item__title"', open_tag | replace: '</ce-title-tag>', close_tag
  %}
</div>
