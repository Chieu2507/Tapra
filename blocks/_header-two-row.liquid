{% doc %}
  Fixed two-row header composition. Reuses the Header controller through its
  existing root attributes. Role slots are static; commerce state stays native.
{% enddoc %}
{% liquid
  assign scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-1' | handleize
  assign container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign container_width = 'full-width'
  endif
%}
<div class="header-top header-top--two-rows" data-header-root data-header-scheme="{{ scheme }}" data-sticky-type="{{ section.settings.sticky_type | default: 'none' }}" data-header-transparent-scheme="{{ scheme }}" data-logo-position="left" data-layout-ready="true" style="--header-icon-size: {{ section.settings.icon_size | default: 24 }}px; --header-icon-mobile: {{ section.settings.icon_size_mobile | default: 20 }}px; --header-main-gap: {{ block.settings.gap | default: 40 }}px; --header-actions-gap: {{ block.settings.actions_gap | default: 8 }}px; --header-grid-top: {{ block.settings.padding_top | default: 24 }}px; --header-grid-bottom: {{ block.settings.padding_bottom | default: 24 }}px; --header-row-gap: {{ block.settings.row_gap | default: 24 }}px;{% if block.settings.customize_mobile_padding %} --header-grid-top-mobile: {{ block.settings.padding_top_mobile }}px; --header-grid-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;{% endif %}" {{ block.shopify_attributes }}>
  <div class="container {{ container_width }} header-two-row__grid">
    <div class="header-two-row__brand">{% content_for 'block', type: '_header-menu-toggle', id: 'header-menu-toggle' %}{% content_for 'block', type: '_header-logo', id: 'header-logo' %}</div>
    {% content_for 'block', type: '_header-search', id: 'header-search' %}
    <div class="header-two-row__actions">{% content_for 'block', type: '_header-link', id: 'header-location' %}{% content_for 'block', type: '_header-account', id: 'header-account' %}{% content_for 'block', type: '_header-cart', id: 'header-cart' %}</div>
    {% content_for 'block', type: '_header-menu', id: 'header-menu' %}
    <div class="header-two-row__localization" data-header-region="bottom">{% content_for 'block', type: '_header-localization', id: 'header-localization' %}</div>
  </div>
</div>
{% stylesheet %}
  .header-top--two-rows { padding: var(--header-grid-top,24px) 0 var(--header-grid-bottom,24px); border-bottom: .5px solid var(--border-color); }
  .header-two-row__grid { display: grid; grid-template-columns: auto minmax(0,1fr) minmax(0,1fr); grid-template-areas: 'brand search actions' 'menu menu localization'; align-items: center; column-gap: var(--header-main-gap,40px); row-gap: var(--header-row-gap,24px); }
  .header-two-row__brand { grid-area: brand; display: flex; align-items: center; gap: 12px; min-width: 0; }
  .header-two-row__grid > .header-search--type-search_bar { grid-area: search; width: 100%; display: flex; min-height: var(--input-height); padding-inline: 20px; gap: 16px; background: var(--header-search-background,var(--color-white,#fff)); color: var(--header-search-color,#181818); border: 0; }
  .header-two-row__grid .header-search__input { padding: 0; font-family: var(--font-body-family); font-weight: var(--font-body-weight); }
  .header-two-row__grid .header-search__input::placeholder { color: var(--header-search-placeholder,#b3b3b3); opacity: 1; }
  .header-two-row__grid .header-search__submit { width: 20px; min-width: 20px; min-height: 0; padding: 0; }
  .header-two-row__actions { grid-area: actions; display: flex; align-items: center; justify-content: flex-end; gap: var(--header-actions-gap,8px); }
  .header-top--two-rows :is(.header-link,.header-account,.header-cart), .header-top--two-rows .header-account__avatar { min-height: 44px; }
  .header-top--two-rows :is(.header-link,.header-account,.header-cart) { display: inline-flex; align-items: center; justify-content: center; padding: 10px; color: var(--body-color); }
  .header-top--two-rows .header-cart { padding-inline-end: 0; }
  .header-top--two-rows .icon { display: inline-flex; width: var(--header-icon-size); height: var(--header-icon-size); }
  .header-top--two-rows .icon img { display: block; width: 100%; height: 100%; }
  .header-top--two-rows .header-search .icon { width: 20px; height: 20px; }
  .header-two-row__grid > .header-menu { grid-area: menu; min-width: 0; width: 100%; }
  .header-two-row__localization { grid-area: localization; justify-self: end; }
  .header-two-row__localization .header-localization { gap: 20px; }
  .header-two-row__localization .header-localization__details--language { order: -1; }
  .header-top--two-rows .header-menu__summary,.header-top--two-rows .header-menu__link { padding-block: 2px; }
  .header-top--two-rows .header-menu__dropdown-icon { width: 16px; height: 16px; }
  @media (max-width: 991.98px) {
    .header-top--two-rows { padding-top: 16px; padding-bottom: 16px; }
    .header-two-row__grid { grid-template-columns: minmax(0,1fr) auto; grid-template-areas: 'brand actions' 'search search'; row-gap: 16px; column-gap: 16px; }
    .header-two-row__grid > .header-menu,.header-two-row__localization { display: none; }
    .header-two-row__brand .header-menu-toggle { display: inline-flex; padding: 10px 10px 10px 0; width: auto; min-width: 0; min-height: 44px; }
    .header-top--two-rows .header-account { display: inline-flex; }
    .header-top--two-rows .header-account__avatar { min-height: 44px; }
    .header-top--two-rows .header-account__mobile-label { display: none; }
  }
  @media (max-width: 767.98px) {
    .header-top--two-rows { --header-icon-size: var(--header-icon-mobile,20px); padding-top: var(--header-grid-top-mobile,var(--header-grid-top,24px)); padding-bottom: var(--header-grid-bottom-mobile,var(--header-grid-bottom,24px)); }
    .header-two-row__grid { row-gap: 8px; }
    .header-two-row__brand { gap: 4px; }
    .header-two-row__actions { gap: 0; }
    .header-top--two-rows :is(.header-link,.header-account,.header-cart),.header-top--two-rows .header-account__avatar,.header-two-row__brand .header-menu-toggle { min-height: 40px; }
    .header-two-row__grid > .header-search--type-search_bar { min-height: var(--input-height-mobile); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Two-row header",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:labels.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "actions_gap",
      "label": "Actions gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ]
}
{% endschema %}
