        },
        {
          "value": "extra_loose",
          "label": "Extra Loose"
        },
        {
          "value": "ultra_loose",
          "label": "Ultra loose"
        },
        {
          "value": "mega_loose",
          "label": "Mega loose"
        }
      ],
      "visible_if": "{{ block.settings.customize_mobile_typography }}",
      "default": "normal"
    },
    {
      "type": "select",
      "id": "text_case_mobile",
