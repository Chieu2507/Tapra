{% render 'collection-editorial-content', block: block, role: 'rich' %}
{% schema %}
{
  "name": "Editorial text",
  "tag": null,
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "Use [img1] through [img5] to insert inline images.",
      "default": "Highlight your products, [img1] your story, or [img2] a collection."
    },
    {
      "type": "checkbox",
      "id": "limit_width",
      "label": "Limit width",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 400,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "visible_if": "{{ block.settings.limit_width }}",
      "default": 750
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Size",
      "options": [
        {
          "value": "display",
          "label": "Heading 1"
        },
        {
          "value": "xl",
          "label": "Heading 2"
        },
        {
          "value": "lg",
          "label": "Heading 3"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "xl"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text style",
      "options": [
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "visible_if": "{{ block.settings.heading_size == 'custom' }}",
      "default": "body"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 200,
      "step": 2,
      "unit": "px",
      "visible_if": "{{ block.settings.heading_size == 'custom' }}",
      "default": 14
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Line height",
      "options": [
        {
          "value": "tighter",
          "label": "Tighter"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "relaxed",
          "label": "Relaxed"
        },
        {
          "value": "loose",
          "label": "Loose"
        },
        {
          "value": "extra_loose",
          "label": "Extra Loose"
        }
      ],
      "visible_if": "{{ block.settings.heading_size == 'custom' }}",
      "default": "loose"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "options": [
        {
          "value": "tighter",
          "label": "Tighter"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "relaxed",
          "label": "Relaxed"
        },
        {
          "value": "loose",
          "label": "Loose"
        },
        {
          "value": "extra_loose",
          "label": "Extra Loose"
        },
        {
          "value": "ultra_loose",
          "label": "Ultra loose"
        },
        {
          "value": "mega_loose",
          "label": "Mega loose"
        }
      ],
      "visible_if": "{{ block.settings.heading_size == 'custom' }}",
      "default": "normal"
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Text case",
      "options": [
        {
          "value": "original",
          "label": "Original"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "visible_if": "{{ block.settings.heading_size == 'custom' }}",
      "default": "original"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_typography",
      "label": "Custom for mobile",
      "visible_if": "{{ block.settings.heading_size == 'custom' }}",
      "default": false
    },
    {
      "type": "select",
      "id": "line_height_mobile",
      "label": "Line height (mobile)",
      "options": [
        {
          "value": "tighter",
          "label": "Tighter"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "relaxed",
          "label": "Relaxed"
        },
        {
          "value": "loose",
          "label": "Loose"
        },
        {
          "value": "extra_loose",
          "label": "Extra Loose"
        }
      ],
      "visible_if": "{{ block.settings.customize_mobile_typography }}",
      "default": "loose"
    },
    {
      "type": "select",
      "id": "letter_spacing_mobile",
      "label": "Letter spacing (mobile)",
      "options": [
        {
          "value": "tighter",
          "label": "Tighter"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "relaxed",
          "label": "Relaxed"
        },
        {
          "value": "loose",
