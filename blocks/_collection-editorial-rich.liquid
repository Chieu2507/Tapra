      "min": 10,
      "max": 200,
      "step": 2,
      "unit": "px",
      "visible_if": "{{ block.settings.customize_mobile_typography }}",
      "default": 14
    },
    {
      "type": "header",
      "content": "Scroll"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll_reveal",
      "label": "Enable scroll reveal",
      "default": true
    },
    {
      "type": "select",
      "id": "scroll_speed",
      "label": "Speed",
      "options": [
        {
          "value": "slow",
          "label": "Slow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "fast",
          "label": "Fast"
        }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "start_opacity",
      "label": "Start opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Image 1"
    },
    {
      "type": "checkbox",
      "id": "show_image_1",
      "label": "Show image 1",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image",
      "visible_if": "{{ block.settings.show_image_1 }}"
    },
    {
      "type": "range",
      "id": "image_width_1",
      "label": "Desktop width",
      "min": 50,
      "max": 250,
      "step": 5,
      "unit": "px",
      "visible_if": "{{ block.settings.show_image_1 }}",
      "default": 150
    },
    {
