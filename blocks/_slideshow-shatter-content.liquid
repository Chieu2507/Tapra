{% doc %}
  Positioned content group for Shatter. Accepts native Heading, Text, Eyebrow
  and Button children. The owning Slide supplies the shared content inset.
{% enddoc %}
{% liquid
  assign position = block.settings.position | default: 'top_left' | split: '_'
  assign mobile_position = position
  if block.settings.customize_mobile_position
    assign mobile_position = block.settings.position_mobile | default: block.settings.position | default: 'top_left' | split: '_'
  endif
  assign content_alignment = position.last
  assign content_alignment_mobile = mobile_position.last
  if block.settings.inherit_alignment == false
    assign content_alignment = block.settings.alignment | default: 'left'
    assign content_alignment_mobile = content_alignment
    if block.settings.customize_mobile_alignment
      assign content_alignment_mobile = block.settings.alignment_mobile | default: content_alignment
    endif
  endif
  assign content_width_mode = block.settings.width | default: 'fit'
  assign content_width = 'fit-content'
  assign content_max_width = ''
  if content_width_mode == 'fill' or content_width_mode == 'custom'
    assign content_width = '100%'
  endif
  if content_width_mode == 'custom'
    assign content_max_width = block.settings.max_width | default: 750 | at_least: 320 | at_most: 1200 | append: 'px'
  endif
  assign content_width_mobile = ''
  assign content_max_width_mobile = ''
  if block.settings.customize_mobile_size
    assign content_width_mobile = 'fit-content'
    assign mobile_width_mode = block.settings.width_mobile | default: content_width_mode
    if mobile_width_mode == 'fill' or mobile_width_mode == 'custom'
      assign content_width_mobile = '100%'
    endif
    assign content_max_width_mobile = '100%'
    if mobile_width_mode == 'custom'
      assign content_max_width_mobile = block.settings.max_width_mobile | default: 480 | at_least: 240 | at_most: 800 | append: 'px'
    endif
  endif
%}
{% capture content_size_spacing %}
  {% render 'size-style', width: content_width, max_width: content_max_width, width_mobile: content_width_mobile, max_width_mobile: content_max_width_mobile %}
  {% for side in (1..4) %}
    {% assign edge = 'top,right,bottom,left' | split: ',' %}
    {% assign edge_index = side | minus: 1 %}
    {% assign edge_name = edge[edge_index] %}
    {% assign padding_key = 'padding_' | append: edge_name %}
    {% assign padding_value = block.settings[padding_key] | default: 0 | at_least: 0 | at_most: 100 %}
    --shatter-content-padding-{{ edge_name }}:{{ padding_value }}px;
    {% if block.settings.customize_mobile_padding %}
      {% assign mobile_padding_key = padding_key | append: '_mobile' %}
      --shatter-content-padding-{{ edge_name }}-mobile:{{ block.settings[mobile_padding_key] | default: 0 | at_least: 0 | at_most: 100 }}px;
    {% endif %}
  {% endfor %}
{% endcapture %}
<div class="shatter__content size-style size-style--contain" data-shatter-content style="{{ content_size_spacing | strip }}--shatter-content-x:{{ position.last | replace: 'left', 'start' | replace: 'right', 'end' }};--shatter-content-y:{{ position.first | replace: 'top', 'start' | replace: 'bottom', 'end' }};--shatter-content-align:{{ content_alignment }};--shatter-content-items:{{ content_alignment | replace: 'left', 'start' | replace: 'right', 'end' }};--shatter-content-x-mobile:{{ mobile_position.last | replace: 'left', 'start' | replace: 'right', 'end' }};--shatter-content-y-mobile:{{ mobile_position.first | replace: 'top', 'start' | replace: 'bottom', 'end' }};--shatter-content-align-mobile:{{ content_alignment_mobile }};--shatter-content-items-mobile:{{ content_alignment_mobile | replace: 'left', 'start' | replace: 'right', 'end' }};--shatter-content-gap:{{ block.settings.gap_desktop | default: 12 }}px;--shatter-content-gap-mobile:{{ block.settings.gap_mobile | default: 12 }}px" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>
