{% doc %}
  Private review card for Testimonials: Cards. Uses the shared testimonial
  renderer and Group/Heading/Text/Image/Icon kernels; its preset recreates
  the owning section's card layout when a merchant adds a new review.
{% enddoc %}
{{ 'component-testimonial-item.css' | asset_url | stylesheet_tag }}
{% capture content %}{% content_for 'blocks' %}{% endcapture %}
{% render 'testimonial-item', block: block, content: content, composition_card: true %}

{% schema %}
{
  "name": "Testimonial card",
  "tag": null,
  "blocks": [
    {
      "type": "group"
    },
    {
      "type": "image"
    },
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "testimonial-rating"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "space-between",
          "label": "Space between"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "Vertical on mobile",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "Mobile alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.direction == 'vertical' or block.settings.vertical_on_mobile }}"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Border thickness",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "Corner radius",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "radius_2",
          "label": "t:options.radius_preset.size_2"
        },
        {
          "value": "slightly_rounded",
          "label": "Slightly rounded"
        },
        {
          "value": "radius_4",
          "label": "t:options.radius_preset.size_4"
        },
        {
          "value": "radius_6",
          "label": "t:options.radius_preset.size_6"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "radius_8",
          "label": "t:options.radius_preset.size_8"
        },
        {
          "value": "radius_12",
          "label": "t:options.radius_preset.size_12"
        },
        {
          "value": "radius_16",
          "label": "t:options.radius_preset.size_16"
        },
        {
          "value": "radius_24",
          "label": "t:options.radius_preset.size_24"
        },
        {
          "value": "radius_32",
          "label": "t:options.radius_preset.size_32"
        },
        {
          "value": "pill",
          "label": "Pill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_corner_radius",
      "label": "t:labels.custom_corner_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.corner_radius == 'custom' }}"
    },
    {
      "type": "select",
      "id": "shadow",
      "label": "Shadow",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "t:labels.show_overlay",
      "default": false
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:labels.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.overlay_style.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.overlay_style.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "overlay_color",
      "label": "t:labels.overlay_color",
      "visible_if": "{{ block.settings.show_overlay and block.settings.overlay_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.52))",
      "label": "t:labels.overlay_gradient",
      "visible_if": "{{ block.settings.show_overlay and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "Customize for mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Mobile left padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Mobile right padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Testimonial card",
      "category": "Trust & social proof",
      "settings": {
        "direction": "vertical",
        "gap_desktop": 28,
        "gap_mobile": 28,
        "corner_radius": "radius_24",
        "custom_corner_radius": 24,
        "background_color": "#ffffff",
        "padding_top": 36,
        "padding_bottom": 36,
        "padding_left": 28,
        "padding_right": 28,
        "show_overlay": true
      },
      "blocks": {
        "content": {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "alignment": "center",
            "alignment_mobile": "center",
            "gap_desktop": 16,
            "gap_mobile": 16,
            "width": "fill",
            "height": "fit",
            "show_overlay": true
          },
          "blocks": {
            "rating": {
              "type": "icon",
              "settings": {
                "source": "library",
                "icon": "five-stars",
                "icon_width": 100,
                "custom_mobile": false
              }
            },
            "copy": {
              "type": "group",
              "settings": {
                "direction": "vertical",
                "alignment": "center",
                "alignment_mobile": "center",
                "gap_desktop": 10,
                "gap_mobile": 10,
                "width": "fill",
                "height": "fit",
                "show_overlay": true
              },
              "blocks": {
                "title": {
                  "type": "heading",
                  "settings": {
                    "text": "<p>Review title</p>",
                    "heading_size": "md",
                    "html_tag": "h3",
                    "width": "fill"
                  }
                },
                "quote": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Share a customer testimonial that builds trust in your products and brand. Describe what they loved and how your product made a difference.</p>",
                    "text_size": "md",
                    "width": "fill",
                    "customize_letter_spacing": true,
                    "letter_spacing": 0
                  }
                }
              },
              "block_order": [
                "title",
                "quote"
              ]
            }
          },
          "block_order": [
            "rating",
            "copy"
          ]
        },
        "author": {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "alignment": "center",
            "alignment_mobile": "center",
            "gap_desktop": 12,
            "gap_mobile": 12,
            "width": "fill",
            "height": "fit",
            "show_overlay": true
          },
          "blocks": {
            "avatar": {
              "type": "image",
              "settings": {
                "image_ratio_desktop": "square",
                "width_desktop": "fixed",
                "width_fixed_desktop": 70,
                "limit_width_desktop": false,
                "max_width_desktop": 1600,
                "image_ratio_mobile": "square",
                "width_mobile": "fixed",
                "width_fixed_mobile": 70,
                "limit_width_mobile": false,
                "max_width_mobile": 1600,
                "background_color": "#fed7a2",
                "corner_radius": "full",
                "image_fit": "contain"
              }
            },
            "name": {
              "type": "text",
              "settings": {
                "text": "<p>Customer name</p>",
                "text_size": "md",
                "text_color": "#181818"
              }
            }
          },
          "block_order": [
            "avatar",
            "name"
          ]
        }
      },
      "block_order": [
        "content",
        "author"
      ]
    }
  ]
}
{% endschema %}
