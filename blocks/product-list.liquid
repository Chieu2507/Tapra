{% doc %}
  Renders a responsive product collection using one static Product Card theme
  block for every product. The block owns the collection query, item count,
  grid/carousel layout, columns, and gaps; Product Card owns presentation.

  @example
  {% content_for 'block', type: 'product-list', id: 'product-list' %}
{% enddoc %}

{% liquid
  assign product_list_row_gap_mobile = block.settings.product_gap_mobile | default: 8
  if block.settings.customize_mobile_row_gap
    assign product_list_row_gap_mobile = block.settings.product_row_gap_mobile | default: product_list_row_gap_mobile
  endif
  assign product_list_collection = block.settings.collection
  assign product_list_layout = block.settings.layout_type | default: 'grid'
  unless product_list_layout == 'grid' or product_list_layout == 'carousel'
    assign product_list_layout = 'grid'
  endunless

  assign product_list_max_products = block.settings.max_products | default: 6 | plus: 0
  if product_list_max_products < 1 or product_list_max_products > 24
    assign product_list_max_products = 6
  endif

  assign product_list_items = blank
  assign product_list_item_limit = product_list_max_products
  assign product_list_is_placeholder = false
  if product_list_collection != blank and product_list_collection.products != blank
    assign product_list_items = product_list_collection.products
  else
    assign product_list_placeholder_count = product_list_max_products
    assign product_list_items = (1..product_list_placeholder_count)
    assign product_list_item_limit = product_list_placeholder_count
    assign product_list_is_placeholder = true
  endif

  assign product_list_carousel_id = 'ProductListCarousel-' | append: block.id
  assign product_list_aria_label = product_list_collection.title
  if product_list_aria_label == blank
    assign product_list_aria_label = 'search.products' | t
  endif

  assign product_list_show_next_slide_preview = false
  if block.settings.show_next_slide_preview_on_desktop
    assign product_list_show_next_slide_preview = true
  endif

  assign product_list_gap_desktop = block.settings.product_gap_desktop | default: block.settings.gap_horizontal | default: 4 | plus: 0
  assign product_list_gap_mobile = block.settings.product_gap_mobile | default: block.settings.gap_horizontal_mobile | default: 4 | plus: 0
  if product_list_gap_desktop < 0 or product_list_gap_desktop > 40
    assign product_list_gap_desktop = 4
  endif
  if product_list_gap_mobile < 0 or product_list_gap_mobile > 40
    assign product_list_gap_mobile = 4
  endif

  assign product_list_navigation_position = block.settings.navigation_position | default: 'inside'
  unless product_list_navigation_position == 'inside' or product_list_navigation_position == 'outside' or product_list_navigation_position == 'top' or product_list_navigation_position == 'bottom'
    assign product_list_navigation_position = 'inside'
  endunless

  assign product_list_navigation_style = block.settings.navigation_style | default: 'secondary'
  if product_list_navigation_style == 'tertiary'
    assign product_list_navigation_style = 'icon_only'
  endif
  unless product_list_navigation_style == 'primary' or product_list_navigation_style == 'secondary' or product_list_navigation_style == 'outline' or product_list_navigation_style == 'icon_only'
    assign product_list_navigation_style = 'secondary'
  endunless

  assign product_list_navigation_button_variant = product_list_navigation_style
  assign product_list_navigation_button_modifier = blank
  if product_list_navigation_style == 'icon_only'
    assign product_list_navigation_button_variant = 'tertiary'
    assign product_list_navigation_button_modifier = 'swiper-nav-button--icon-only'
  elsif product_list_navigation_style == 'outline'
    assign product_list_navigation_button_variant = 'secondary'
    assign product_list_navigation_button_modifier = 'swiper-nav-button--outline'
  endif

  assign product_list_navigation_icon = block.settings.navigation_icon | default: 'chevron'
  unless product_list_navigation_icon == 'chevron' or product_list_navigation_icon == 'arrow' or product_list_navigation_icon == 'long_arrow'
    assign product_list_navigation_icon = 'chevron'
  endunless

  assign product_list_navigation_behavior = 'show_on_hover'
  if product_list_navigation_position != blank
    assign product_list_navigation_behavior = block.settings.navigation_behavior | default: 'show_on_hover'
    unless product_list_navigation_behavior == 'show_on_hover' or product_list_navigation_behavior == 'always'
      assign product_list_navigation_behavior = 'show_on_hover'
    endunless
  endif

  assign product_list_show_navigation = true
  if block.settings.show_navigation_on_desktop == false or block.settings.show_navigation_on_desktop == 'false'
    assign product_list_show_navigation = false
  endif

  assign product_list_pagination_type = block.settings.pagination_type | default: 'progress_bar'
  unless product_list_pagination_type == 'progress_bar' or product_list_pagination_type == 'bullets'
    assign product_list_pagination_type = 'progress_bar'
  endunless

  assign product_list_pagination_size = 'var(--swiper-pagination-progressbar-size, 4px)'
  if product_list_pagination_type == 'bullets'
    assign product_list_pagination_size = 'var(--swiper-pagination-bullet-size, 0.5rem)'
  endif

  assign product_list_pagination_limit_width = false
  if product_list_pagination_type == 'progress_bar' and block.settings.pagination_limit_width
    assign product_list_pagination_limit_width = true
  endif

  assign product_list_pagination_top_padding_desktop = block.settings.pagination_top_padding_desktop | default: block.settings.pagination_top_padding | default: 50 | plus: 0
  if product_list_pagination_top_padding_desktop < 0 or product_list_pagination_top_padding_desktop > 100
    assign product_list_pagination_top_padding_desktop = 50
  endif

  assign product_list_pagination_top_padding_mobile = block.settings.pagination_top_padding_mobile | default: 24 | plus: 0
  if product_list_pagination_top_padding_mobile < 0 or product_list_pagination_top_padding_mobile > 100
    assign product_list_pagination_top_padding_mobile = 24
  endif

  assign product_list_pagination_max_width = block.settings.pagination_max_width | default: 260 | plus: 0
  if product_list_pagination_max_width < 100 or product_list_pagination_max_width > 600
    assign product_list_pagination_max_width = 260
  endif

  assign product_list_show_pagination = false
  if product_list_layout == 'carousel'
    assign product_list_show_pagination = true
    if block.settings.show_pagination_on_desktop == false or block.settings.show_pagination_on_desktop == 'false'
      assign product_list_show_pagination = false
    endif
  endif

  assign product_list_autoplay_enabled = false
  if product_list_layout == 'carousel' and block.settings.autoplay
    assign product_list_autoplay_enabled = true
  endif

  assign product_list_autoplay_pause_on_hover = true
  if block.settings.autoplay_pause_on_hover == false or block.settings.autoplay_pause_on_hover == 'false'
    assign product_list_autoplay_pause_on_hover = false
  endif

  assign product_list_autoplay_speed = block.settings.autoplay_speed | default: 4 | plus: 0
  if product_list_autoplay_speed < 1 or product_list_autoplay_speed > 10
    assign product_list_autoplay_speed = 4
  endif
  assign product_list_autoplay_delay = product_list_autoplay_speed | times: 1000

  assign product_list_pagination_visibility = block.settings.pagination_visibility | default: 'both'

  assign product_list_pagination_class = 'swiper-pagination--below product-list__pagination product-list__pagination--' | append: product_list_pagination_type
%}

{% capture product_list_promo_cards %}{% content_for 'blocks' %}{% endcapture %}
{% liquid
  assign product_list_actual_count = product_list_items.size | at_most: product_list_item_limit
  assign product_list_last_position = product_list_actual_count | plus: 1
%}
{% capture product_list_items_content %}
  {% if product_list_items != blank %}
    {% for product_list_item in product_list_items limit: product_list_item_limit %}
      {% liquid
        assign product_list_card_product = product_list_item
        assign product_list_card_placeholder = false
        if product_list_is_placeholder
          assign product_list_card_product = blank
          assign product_list_card_placeholder = true
        endif
      %}
      {% render 'product-list-promo-items', cards: product_list_promo_cards, position: forloop.index, last_position: product_list_last_position, layout: product_list_layout %}
      <div class="{% if product_list_layout == 'carousel' %}swiper-slide {% endif %}product-collection-grid__item product-card-layout__item product-list__item">
        {% content_for 'block', type: 'product-card', id: 'product-card', product: product_list_card_product, closest.product: product_list_card_product, placeholder_index: forloop.index, placeholder: product_list_card_placeholder %}
      </div>
    {% endfor %}
  {% endif %}
  {% render 'product-list-promo-items', cards: product_list_promo_cards, position: product_list_last_position, last_position: product_list_last_position, layout: product_list_layout %}
{% endcapture %}

{% capture product_list_pagination_style %}
  {% if product_list_show_pagination %}
    {% if block.settings.pagination_thickness == 'thin' %}--swiper-pagination-progressbar-size: 2px;{% endif %}
    --swiper-pagination-spacing: {{ product_list_pagination_top_padding_desktop }}px;
    --swiper-pagination-spacing-mobile: {{ product_list_pagination_top_padding_mobile }}px;
    {% if product_list_pagination_limit_width %}--swiper-pagination-width: min(100%, {{ product_list_pagination_max_width }}px);{% endif %}
  {% endif %}
{% endcapture %}
{% assign product_list_pagination_style = product_list_pagination_style | strip %}

{% capture product_list_navigation_center_style %}
  {% if block.settings.navigation_button_size > 0 %}--swiper-nav-size: {{ block.settings.navigation_button_size | at_least: 2 | at_most: 80 }}px;{% endif %}
  {% if block.settings.navigation_gap != blank and block.settings.navigation_gap != 8 %}--product-list-navigation-gap: {{ block.settings.navigation_gap | at_least: 0 | at_most: 40 }}px;{% endif %}
  {% if product_list_layout == 'carousel' and product_list_show_pagination and product_list_pagination_visibility != 'mobile' and product_list_pagination_visibility != 'tablet_mobile' and product_list_navigation_position != 'top' and product_list_navigation_position != 'bottom' %}--swiper-navigation-center-offset: calc(({{ product_list_pagination_top_padding_desktop }}px + {{ product_list_pagination_size }}) / 2);{% endif %}
{% endcapture %}
{% assign product_list_navigation_center_style = product_list_navigation_center_style | strip %}

{% capture product_list_navigation_markup %}
  {% if product_list_layout == 'carousel' and product_list_show_navigation %}
    <div
      class="swiper-carousel__navigation--centered swiper-carousel__navigation--{{ product_list_navigation_behavior }} product-list__navigation product-list__navigation--{{ product_list_navigation_position }} product-list__navigation--{{ product_list_navigation_behavior }}"
      data-product-list-navigation
      {% if product_list_navigation_center_style != blank %}style="{{ product_list_navigation_center_style }}"{% endif %}
    >
      <button
        class="btn btn-{{ product_list_navigation_button_variant }} btn--{{ product_list_navigation_button_variant }} btn--icon{% if product_list_navigation_button_modifier != blank %} {{ product_list_navigation_button_modifier }}{% endif %} swiper-nav-button swiper-nav-button--prev product-list__carousel-button"
        type="button"
        data-product-list-previous
        aria-label="{{ 'collection_tabs.previous' | t | escape }}"
      >
        {% render 'carousel-navigation-icon', icon: product_list_navigation_icon, direction: 'previous' %}
      </button>
      <button
        class="btn btn-{{ product_list_navigation_button_variant }} btn--{{ product_list_navigation_button_variant }} btn--icon{% if product_list_navigation_button_modifier != blank %} {{ product_list_navigation_button_modifier }}{% endif %} swiper-nav-button swiper-nav-button--next product-list__carousel-button"
        type="button"
        data-product-list-next
        aria-label="{{ 'collection_tabs.next' | t | escape }}"
      >
        {% render 'carousel-navigation-icon', icon: product_list_navigation_icon, direction: 'next' %}
      </button>
    </div>
  {% endif %}
{% endcapture %}
{% assign product_list_navigation_markup = product_list_navigation_markup | strip %}

{% if product_list_promo_cards contains '<!--promo-card-slot:' %}
  <script data-theme-module="{{ 'product-list-promos.js' | asset_url }}"></script>
{% endif %}
{% if product_list_layout == 'carousel' %}
  <script data-theme-module="{{ 'product-collection-carousel.js' | asset_url }}"></script>
{% endif %}

<div
  class="product-list"
  data-product-list
  style="--product-list-mobile-promo-gap: {{ block.settings.mobile_promo_gap | default: 24 }}px; --product-list-mobile-promo-height: {{ block.settings.mobile_promo_height | default: 360 }}px;"
  data-resource-count="{{ product_list_collection.products_count | default: 0 }}"
  data-resource-limit="{{ product_list_max_products }}"
  data-layout="{{ product_list_layout }}"
  data-navigation-position="{{ product_list_navigation_position }}"
  data-pagination-visibility="{{ product_list_pagination_visibility }}"
  data-collection-url="{{ product_list_collection.url | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="product-list__mobile-promos" data-product-list-mobile-promos></div>
  {% if product_list_navigation_position == 'top' %}{{ product_list_navigation_markup }}{% endif %}
  <div class="product-list__carousel swiper-carousel__container" data-product-list-carousel>
    {% render 'product-collection-grid',
      collection: product_list_collection,
      max_products: product_list_max_products,
      layout_type: product_list_layout,
      columns_desktop: block.settings.columns_desktop,
      columns_mobile: block.settings.columns_mobile,
      columns_tablet: block.settings.columns_tablet,
      gap_horizontal: product_list_gap_desktop,
      gap_vertical: product_list_gap_desktop,
      gap_horizontal_mobile: product_list_gap_mobile,
      gap_vertical_mobile: product_list_row_gap_mobile,
      show_placeholders: true,
      show_placeholders_for_empty_collection: true,
      placeholder_count: product_list_max_products,
      grid_class: 'product-list__items',
      item_class: 'product-list__item',
      items_data_attributes: 'data-product-list-items',
      next_slide_preview: product_list_show_next_slide_preview,
      next_slide_preview_mobile: block.settings.show_next_slide_preview_on_mobile,
      carousel_id: product_list_carousel_id,
      aria_label: product_list_aria_label,
      previous_selector: '[data-product-list-previous]',
      next_selector: '[data-product-list-next]',
      show_pagination: product_list_show_pagination,
      pagination_type: product_list_pagination_type,
      pagination_class: product_list_pagination_class,
      pagination_style: product_list_pagination_style,
      autoplay: product_list_autoplay_enabled,
      autoplay_pause_on_hover: product_list_autoplay_pause_on_hover,
      autoplay_delay: product_list_autoplay_delay,
      items_content: product_list_items_content
    %}

    {% if product_list_navigation_position != blank and product_list_navigation_position != 'top' %}{{ product_list_navigation_markup }}{% endif %}
  </div>
</div>

{% stylesheet %}
  .product-list {
    width: 100%;
    min-width: 0;
  }



  @media (min-width: 768px) {
    .product-list[data-pagination-visibility='mobile'] .product-list__pagination { display: none; }
  }
  @media (min-width: 1150px) {
    .product-list[data-pagination-visibility='tablet_mobile'] .product-list__pagination { display: none; }
  }
  @media (max-width: 767.98px) {
    .product-list[data-pagination-visibility='desktop'] .product-list__pagination { display: none; }
  }

  .product-list__carousel {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .product-list__navigation {
    position: absolute;
    z-index: 1;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 0.5rem;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .product-list__navigation--outside {
    padding-inline: 0;
  }

  .product-list__navigation.product-list__navigation--top {
    position: relative;
    inset: auto;
    width: max-content;
    max-width: 100%;
    gap: var(--product-list-navigation-gap, 0.5rem);
    padding-inline: 0;
    transform: none;
  }

  .product-list__navigation--outside .swiper-nav-button--prev {
    margin-inline-start: calc(-1 * var(--swiper-nav-size) / 2);
  }

  .product-list__navigation--outside .swiper-nav-button--next {
    margin-inline-end: calc(-1 * var(--swiper-nav-size) / 2);
  }

  .product-list__carousel-button {
    pointer-events: auto;
  }

  @media (max-width: 767.98px) {
    .product-list__navigation,
    .product-list__navigation.product-list__navigation--top {
      display: none;
    }
  }

  .product-list__carousel:has(> .product-list__navigation--bottom) {
    --product-list-controls-width: 76px;
    --product-list-controls-gap: 40px;
  }
  .product-list__navigation.product-list__navigation--bottom {
    position: absolute;
    inset: auto 0 0 auto;
    width: var(--product-list-controls-width);
    padding: 0;
    gap: 28px;
    transform: translateY(50%);
  }
  .product-list__navigation--bottom .swiper-nav-button {
    --swiper-nav-size: 24px;
    --swiper-nav-icon-size: 24px;
    flex: 0 0 24px;
  }
  @media (min-width: 768px) {
    .product-list__carousel:has(> .product-list__navigation--bottom) .product-list__pagination {
      max-width: calc(100% - var(--product-list-controls-width) - var(--product-list-controls-gap));
      margin-inline: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_list",
  "tag": null,
  "blocks": [
    {
      "type": "promo-card"
    }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:labels.max_products",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:labels.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.product_list_layout.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.product_list_layout.carousel"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:labels.desktop_columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Tablet columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "show_next_slide_preview_on_desktop",
      "label": "t:labels.show_next_slide_preview_on_desktop",
      "default": false,
      "visible_if": "{{ block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "show_next_slide_preview_on_mobile",
      "label": "t:labels.show_next_slide_preview_on_mobile",
      "default": false,
      "visible_if": "{{ block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "t:general.products_gap"
    },
    {
      "type": "range",
      "id": "product_gap_desktop",
      "label": "t:options.device.desktop",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "product_gap_mobile",
      "label": "t:options.device.mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_promo_gap",
      "label": "Gap after top promos (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_promo_height",
      "label": "Minimum top promo height (mobile)",
      "min": 200,
      "max": 600,
      "step": 4,
      "unit": "px",
      "default": 360
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_row_gap",
      "label": "Customize mobile row gap",
      "default": false,
      "visible_if": "{{ block.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "product_row_gap_mobile",
      "label": "Mobile row gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.layout_type == 'grid' and block.settings.customize_mobile_row_gap }}"
    },
    {
      "type": "header",
      "content": "t:general.navigation",
      "visible_if": "{{ block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "show_navigation_on_desktop",
      "label": "t:labels.show_navigation_on_desktop",
      "default": true,
      "visible_if": "{{ block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "navigation_position",
      "label": "t:labels.position",
      "options": [
        {
          "value": "outside",
          "label": "t:options.collection_navigation_position.outside"
        },
        {
          "value": "inside",
          "label": "t:options.collection_navigation_position.inside"
        },
        {
          "value": "top",
          "label": "t:options.position.top"
        },
        {
          "value": "bottom",
          "label": "t:options.position.bottom"
        }
      ],
      "default": "inside",
      "visible_if": "{{ block.settings.layout_type == 'carousel' and block.settings.show_navigation_on_desktop }}"
    },
    {
      "type": "range",
      "id": "navigation_button_size",
      "label": "t:labels.navigation_button_size",
      "info": "t:info.navigation_button_size",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.layout_type == 'carousel' and block.settings.show_navigation_on_desktop }}"
    },
    {
      "type": "range",
      "id": "navigation_gap",
      "label": "t:labels.gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.layout_type == 'carousel' and block.settings.show_navigation_on_desktop and block.settings.navigation_position == 'top' }}"
    },
    {
      "type": "select",
      "id": "navigation_style",
      "label": "t:labels.style",
      "options": [
        {
          "value": "primary",
          "label": "t:options.button_variant.primary"
        },
        {
          "value": "secondary",
          "label": "t:options.button_variant.secondary"
        },
        {
          "value": "outline",
          "label": "t:options.button_variant.outline"
        },
        {
          "value": "icon_only",
          "label": "t:options.button_variant.icon_only"
        }
