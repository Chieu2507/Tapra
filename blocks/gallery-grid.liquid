{% doc %}
  Composes Gallery image blocks as a grid or scroll-driven parallax columns.
  Layout, columns, viewport, fade and movement are owned by this block.
  Without JavaScript, parallax falls back to the accessible ordinary grid.
{% enddoc %}
{% liquid
  assign columns_desktop = block.settings.columns_desktop | default: 4 | plus: 0
  assign columns_mobile = block.settings.columns_mobile | default: 1 | plus: 0
  assign gap = block.settings.gap | default: 32 | plus: 0
  assign gap_mobile = block.settings.gap_mobile | default: 24 | plus: 0
  assign width = block.settings.width | default: 'fill'
  assign max_width = block.settings.max_width | default: 1600 | plus: 0
  assign width_value = '100%'
  if width == 'custom'
    assign width_value = max_width | append: 'px'
  elsif width == 'fit'
    assign width_value = 'fit-content'
  endif
  assign padding_top = block.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign padding_left = block.settings.padding_left | default: 0 | plus: 0
  assign padding_right = block.settings.padding_right | default: 0 | plus: 0
  assign padding_top_mobile = block.settings.padding_top_mobile | default: padding_top | plus: 0
  assign padding_bottom_mobile = block.settings.padding_bottom_mobile | default: padding_bottom | plus: 0
  assign padding_left_mobile = block.settings.padding_left_mobile | default: padding_left | plus: 0
  assign padding_right_mobile = block.settings.padding_right_mobile | default: padding_right | plus: 0
  unless block.settings.customize_mobile_padding
    assign padding_top_mobile = padding_top
    assign padding_bottom_mobile = padding_bottom
    assign padding_left_mobile = padding_left
    assign padding_right_mobile = padding_right
  endunless
  assign gallery_color_scheme = block.settings.color_scheme | default: 'scheme-1'
  if block.settings.color_scheme.id != blank
    assign gallery_color_scheme = block.settings.color_scheme.id
  endif
%}

{% if block.settings.layout == 'parallax' %}<script src="{{ 'gallery-parallax.js' | asset_url }}" defer></script>{% endif %}
<div data-gallery-layout="{{ block.settings.layout | default: 'grid' }}" data-gallery-parallax data-gallery-item-sizing="{{ block.settings.item_sizing | default: 'responsive' }}" data-mobile-columns-mode="{{ block.settings.mobile_columns_mode | default: 'redistribute' }}" data-parallax-direction="{{ block.settings.parallax_direction | default: 'alternating' }}" class="gallery-grid{% if block.settings.scroll_on_small_screens and block.settings.layout != 'parallax' %} gallery-grid--scroll{% endif %} color-scheme section-color-scope {{ gallery_color_scheme | handleize }}" style="--gallery-parallax-height: {{ block.settings.parallax_height | default: 820 }}px; --gallery-parallax-height-mobile: {{ block.settings.parallax_height_mobile | default: 640 }}px; --gallery-parallax-distance: {{ block.settings.parallax_distance | default: 130 }}; --gallery-parallax-stagger: {{ block.settings.column_stagger | default: 0 }}px; --gallery-parallax-fade: {{ block.settings.edge_fade | default: 0 }}%; --gallery-parallax-background: {{ block.settings.background_color | default: 'var(--background-color)'  }}; --gallery-grid-item-width: {{ block.settings.item_width | default: 256 }}px; --gallery-grid-columns: {{ columns_desktop }}; --gallery-grid-columns-mobile: {{ columns_mobile }}; --gallery-grid-gap: {{ gap }}px; --gallery-grid-gap-mobile: {{ gap_mobile }}px; --gallery-grid-width: {{ width_value }}; --gallery-grid-padding-top: {{ padding_top }}px; --gallery-grid-padding-bottom: {{ padding_bottom }}px; --gallery-grid-padding-left: {{ padding_left }}px; --gallery-grid-padding-right: {{ padding_right }}px; --gallery-grid-padding-top-mobile: {{ padding_top_mobile }}px; --gallery-grid-padding-bottom-mobile: {{ padding_bottom_mobile }}px; --gallery-grid-padding-left-mobile: {{ padding_left_mobile }}px; --gallery-grid-padding-right-mobile: {{ padding_right_mobile }}px;" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .gallery-grid { background-color: var(--gallery-parallax-background, var(--background-color)); display: grid; grid-template-columns: repeat(var(--gallery-grid-columns), minmax(0, 1fr)); gap: var(--gallery-grid-gap); width: var(--gallery-grid-width, 100%); max-width: 100%; min-width: 0; padding: var(--gallery-grid-padding-top) var(--gallery-grid-padding-right) var(--gallery-grid-padding-bottom) var(--gallery-grid-padding-left); }
  .gallery-grid > * { min-width: 0; }
  @media (max-width: 1149.98px) {
    .gallery-grid--scroll { align-self: flex-start; display: flex; overflow-x: auto; overscroll-behavior-inline: contain; scroll-snap-type: x proximity; scrollbar-width: none; width: calc(100% + var(--page-margin-current)); max-width: none; padding-right: var(--page-margin-current); }
    .gallery-grid--scroll::-webkit-scrollbar { display: none; }
    .gallery-grid--scroll > * { flex: 0 0 var(--gallery-grid-item-width, 256px); scroll-snap-align: start; }
  }
  @media (max-width: 767.98px) { .gallery-grid { grid-template-columns: repeat(var(--gallery-grid-columns-mobile), minmax(0, 1fr)); gap: var(--gallery-grid-gap-mobile); padding: var(--gallery-grid-padding-top-mobile) var(--gallery-grid-padding-right-mobile) var(--gallery-grid-padding-bottom-mobile) var(--gallery-grid-padding-left-mobile); } }
{% endstylesheet %}

{% render 'component-stylesheet', filename: 'component-gallery-parallax.css', section_index: section.index %}

{% schema %}
{
  "name": "Gallery",
  "tag": null,
  "blocks": [
    {
      "type": "gallery-image"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:gallery_extension.label_gallery_layout",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "t:gallery_extension.label_grid"
        },
        {
          "value": "parallax",
          "label": "t:gallery_extension.label_parallax"
        }
      ]
    },
    {
      "type": "header",
      "content": "Items per row"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "scroll_on_small_screens",
      "label": "Scroll on tablet and mobile",
      "default": false,
      "visible_if": "{{ block.settings.layout != 'parallax' }}"
    },
    {
      "type": "select",
      "id": "item_sizing",
      "label": "Parallax item sizing",
      "default": "responsive",
      "options": [
        {
          "value": "responsive",
          "label": "Responsive"
        },
        {
          "value": "fixed",
          "label": "Minimum width"
        }
      ],
      "visible_if": "{{ block.settings.layout == 'parallax' }}"
    },
    {
      "type": "range",
      "id": "item_width",
      "label": "Item width",
      "min": 160,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 256,
      "visible_if": "{{ block.settings.layout == 'parallax' and block.settings.item_sizing == 'fixed' or block.settings.layout != 'parallax' and block.settings.scroll_on_small_screens }}"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Size",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 320,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1600,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop column gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile column gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Parallax"
    },
    {
      "type": "range",
      "id": "parallax_height",
      "label": "t:gallery_extension.label_desktop_gallery_height",
      "min": 200,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 820,
      "visible_if": "{{ block.settings.layout == 'parallax' }}"
    },
    {
      "type": "range",
      "id": "parallax_height_mobile",
      "label": "t:gallery_extension.label_mobile_gallery_height",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 640,
      "visible_if": "{{ block.settings.layout == 'parallax' }}"
    },
    {
      "type": "range",
      "id": "parallax_distance",
      "label": "t:gallery_extension.label_movement_distance",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 130,
      "visible_if": "{{ block.settings.layout == 'parallax' }}"
    },
    {
      "type": "select",
      "id": "parallax_direction",
      "label": "t:gallery_extension.label_column_movement",
      "default": "alternating",
      "options": [
        {
          "value": "alternating",
          "label": "t:gallery_extension.label_alternating"
        },
        {
          "value": "up",
          "label": "t:gallery_extension.label_up"
        },
        {
          "value": "down",
          "label": "t:gallery_extension.label_down"
        }
      ],
      "visible_if": "{{ block.settings.layout == 'parallax' }}"
    },
    {
      "type": "range",
      "id": "column_stagger",
      "label": "t:gallery_extension.label_column_stagger",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.layout == 'parallax' }}"
    },
    {
      "type": "range",
      "id": "edge_fade",
      "label": "t:gallery_extension.label_edge_fade",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 7,
      "visible_if": "{{ block.settings.layout == 'parallax' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns_mode",
      "label": "t:gallery_extension.label_mobile_items",
      "default": "redistribute",
      "options": [
        {
          "value": "redistribute",
          "label": "t:gallery_extension.label_all_items"
        },
        {
          "value": "first_columns",
          "label": "t:gallery_extension.label_first_desktop_columns"
        }
      ],
      "visible_if": "{{ block.settings.layout == 'parallax' }}"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "alpha": true
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:labels.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:labels.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:labels.mobile_left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:labels.mobile_right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Gallery grid",
      "category": "Gallery"
    }
  ]
}
{% endschema %}
