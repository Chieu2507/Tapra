{% doc %}
  Editable Why us card using the shared Group layout and appearance kernel.
{% enddoc %}
{% capture children %}{% content_for 'blocks' %}{% endcapture %}
{% render 'group-content', block: block, section: section, children: children %}
{% schema %}
{
  "name": "Card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.width",
      "options": [
        {
          "value": "fit",
          "label": "t:options.width.fit"
        },
        {
          "value": "fill",
          "label": "t:options.width.fill"
        },
        {
          "value": "custom",
          "label": "t:options.width.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "t:labels.custom_width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "limit_width",
      "label": "t:labels.limit_width",
      "default": false,
      "visible_if": "{{ block.settings.width != 'fit' }}"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:labels.max_width",
      "min": 320,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 640,
      "visible_if": "{{ block.settings.width != 'fit' and block.settings.limit_width }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:labels.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.width.fit"
        },
        {
          "value": "fill",
          "label": "t:options.width.fill"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:labels.position",
      "options": [
        {
          "value": "top",
          "label": "t:options.position.top"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "bottom",
          "label": "t:options.position.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.alignment.space_between"
        }
      ],
      "default": "top",
      "visible_if": "{{ block.settings.height == 'fill' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_alignment",
      "label": "t:labels.vertical_on_mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "t:labels.alignment_mobile",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.desktop_gap",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "appearance_type",
      "label": "t:labels.type",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.appearance_type.inherit"
        },
        {
          "value": "scheme",
          "label": "t:options.appearance_type.scheme"
        }
      ],
      "default": "scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2",
      "visible_if": "{{ block.settings.appearance_type == 'scheme' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "t:labels.background_color",
      "visible_if": "{{ block.settings.appearance_type == 'scheme' }}",
      "default": "#E6EAF0"
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "t:labels.corner_radius",
      "options": [
        {
          "value": "square",
          "label": "t:options.radius_preset.square"
        },
        {
          "value": "radius_2",
          "label": "t:options.radius_preset.size_2"
        },
        {
          "value": "slightly_rounded",
          "label": "t:options.radius_preset.slightly_rounded"
        },
        {
          "value": "radius_4",
          "label": "t:options.radius_preset.size_4"
        },
        {
          "value": "radius_6",
          "label": "t:options.radius_preset.size_6"
        },
        {
          "value": "rounded",
          "label": "t:options.radius_preset.rounded"
        },
        {
          "value": "radius_8",
          "label": "t:options.radius_preset.size_8"
        },
        {
          "value": "radius_12",
          "label": "t:options.radius_preset.size_12"
        },
        {
          "value": "radius_16",
          "label": "t:options.radius_preset.size_16"
        },
        {
          "value": "radius_24",
          "label": "t:options.radius_preset.size_24"
        },
        {
          "value": "radius_32",
          "label": "t:options.radius_preset.size_32"
        },
        {
          "value": "pill",
          "label": "t:options.radius_preset.pill"
        }
      ],
      "default": "radius_24"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "Type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "scale",
          "label": "Scale"
        },
        {
          "value": "slide-left",
          "label": "Slide from left"
        },
        {
          "value": "slide-right",
          "label": "Slide from right"
        },
        {
          "value": "slide-bottom",
          "label": "Slide from bottom"
        }
      ],
      "default": "slide-bottom"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "Delay",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:labels.left_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:labels.right_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:labels.mobile_left_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:labels.mobile_right_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "blocks": [
    {
      "type": "icon"
    },
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "eyebrow"
    },
    {
      "type": "button"
    }
  ],
  "presets": [
    {
      "name": "Card",
      "settings": {
        "alignment": "left",
        "gap_desktop": 22,
        "gap_mobile": 22,
        "appearance_type": "scheme",
        "color_scheme": "scheme-2",
        "background_color": "#E6EAF0",
        "corner_radius": "radius_24",
        "padding_top": 26,
        "padding_bottom": 26,
        "padding_left": 26,
        "padding_right": 26,
        "animation_type": "slide-bottom",
        "animation_delay": 0,
        "width": "fill",
        "height": "fill",
        "position": "top"
      },
      "blocks": [
        {
          "type": "icon",
          "settings": {
            "icon": "truck",
            "icon_width": 48
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Share a benefit of shopping with your store.</p>",
            "text_size": "md",
            "width": "fill"
          }
        }
      ]
    }
  ]
}
{% endschema %}
