{% doc %}
  Renders an independent responsive image kernel with an optional link.

  The block owns its image source, responsive ratio, relative or fixed width,
  optional background, solid or gradient overlay, radius and padding,
  while the shared image snippet owns semantic media markup and image loading.

  @example
  {% content_for 'block', type: 'image', id: 'image' %}
{% enddoc %}
{% capture effective_overlay %}
  {% if block.settings.show_overlay %}
    {% render 'overlay-background', overlay_settings: block.settings %}
  {% endif %}
{% endcapture %}
{% assign effective_overlay = effective_overlay | strip %}

{% liquid
  assign image_source = block.settings.image
  assign mobile_image_source = block.settings.mobile_image

  assign image_ratio_desktop_setting = block.settings.image_ratio_desktop | default: 'auto'
  capture image_ratio_desktop
    render 'image-ratio-value', setting: image_ratio_desktop_setting, fallback_ratio: 'auto', custom_width: block.settings.image_ratio_custom_width_desktop, custom_height: block.settings.image_ratio_custom_height_desktop
  endcapture
  assign image_ratio_desktop = image_ratio_desktop | strip
  assign image_height_desktop = 'auto'
  if image_ratio_desktop_setting == 'square' or image_ratio_desktop_setting == 'portrait' or image_ratio_desktop_setting == 'landscape' or image_ratio_desktop_setting == 'ratio_7_6' or image_ratio_desktop_setting == 'wide' or image_ratio_desktop_setting == 'custom'
    assign image_height_desktop = '100%'
  endif

  assign image_ratio_mobile_setting = block.settings.image_ratio_mobile | default: 'auto'
  capture image_ratio_mobile
    render 'image-ratio-value', setting: image_ratio_mobile_setting, fallback_ratio: 'auto', custom_width: block.settings.image_ratio_custom_width_mobile, custom_height: block.settings.image_ratio_custom_height_mobile
  endcapture
  assign image_ratio_mobile = image_ratio_mobile | strip
  assign image_height_mobile = 'auto'
  if image_ratio_mobile_setting == 'square' or image_ratio_mobile_setting == 'portrait' or image_ratio_mobile_setting == 'landscape' or image_ratio_mobile_setting == 'ratio_7_6' or image_ratio_mobile_setting == 'wide' or image_ratio_mobile_setting == 'custom'
    assign image_height_mobile = '100%'
  endif

  assign image_width_desktop_setting = block.settings.width_desktop | default: 'fit'
  unless image_width_desktop_setting == 'fit' or image_width_desktop_setting == 'fill' or image_width_desktop_setting == 'custom' or image_width_desktop_setting == 'fixed'
    assign image_width_desktop_setting = 'fit'
  endunless
  assign image_width_desktop = 'fit-content'
  assign image_size_desktop = '100vw'
  if image_width_desktop_setting == 'fill'
    assign image_width_desktop = '100%'
  elsif image_width_desktop_setting == 'custom'
    assign image_width_desktop_value = block.settings.width_custom_desktop | default: 100 | plus: 0
    if image_width_desktop_value < 10 or image_width_desktop_value > 100
      assign image_width_desktop_value = 100
    endif
    assign image_width_desktop = image_width_desktop_value | append: '%'
    assign image_size_desktop = image_width_desktop_value | append: 'vw'
  endif

  assign image_width_mobile_setting = block.settings.width_mobile | default: 'fit'
  unless image_width_mobile_setting == 'fit' or image_width_mobile_setting == 'fill' or image_width_mobile_setting == 'custom' or image_width_mobile_setting == 'fixed'
    assign image_width_mobile_setting = 'fit'
  endunless
  assign image_width_mobile = 'fit-content'
  assign image_size_mobile = '100vw'
  if image_width_mobile_setting == 'fill'
    assign image_width_mobile = '100%'
  elsif image_width_mobile_setting == 'custom'
    assign image_width_mobile_value = block.settings.width_custom_mobile | default: 100 | plus: 0
    if image_width_mobile_value < 10 or image_width_mobile_value > 100
      assign image_width_mobile_value = 100
    endif
    assign image_width_mobile = image_width_mobile_value | append: '%'
    assign image_size_mobile = image_width_mobile_value | append: 'vw'
  endif

  if image_width_desktop_setting == 'fixed'
    assign image_fixed_width_desktop = block.settings.width_fixed_desktop | default: 70 | at_least: 20 | at_most: 200
    assign image_width_desktop = image_fixed_width_desktop | append: 'px'
    assign image_size_desktop = image_width_desktop
  endif

  assign image_max_width_desktop = '100%'
  assign max_width_desktop = block.settings.max_width_desktop | default: 1600 | plus: 0
  if max_width_desktop < 0 or max_width_desktop > 1600
    assign max_width_desktop = 1600
  endif
  if block.settings.limit_width_desktop and max_width_desktop > 0
    assign image_max_width_desktop = max_width_desktop | append: 'px'
  endif

  if image_width_mobile_setting == 'fixed'
    assign image_fixed_width_mobile = block.settings.width_fixed_mobile | default: 70 | at_least: 20 | at_most: 200
    assign image_width_mobile = image_fixed_width_mobile | append: 'px'
    assign image_size_mobile = image_width_mobile
  endif

  assign image_max_width_mobile = '100%'
  assign max_width_mobile = block.settings.max_width_mobile | default: 1600 | plus: 0
  if max_width_mobile < 0 or max_width_mobile > 1600
    assign max_width_mobile = 1600
  endif
  if block.settings.limit_width_mobile and max_width_mobile > 0
    assign image_max_width_mobile = max_width_mobile | append: 'px'
  endif
  comment
    Responsive candidates must respect the same max-width as the image box.
    Percentage sizes are invalid in HTML; use viewport units as the upper bound.
  endcomment
  if block.settings.limit_width_desktop and max_width_desktop > 0
    capture image_size_desktop
      echo 'min('
      echo image_size_desktop
      echo ', '
      echo max_width_desktop
      echo 'px)'
    endcapture
  endif
  if block.settings.limit_width_mobile and max_width_mobile > 0
    capture image_size_mobile
      echo 'min('
      echo image_size_mobile
      echo ', '
      echo max_width_mobile
      echo 'px)'
    endcapture
  endif

  assign image_corner_radius = block.settings.corner_radius | default: 'square'
  assign image_custom_corner_radius = block.settings.custom_corner_radius | default: 0 | plus: 0
  unless image_corner_radius == 'inherit' or image_corner_radius == 'square' or image_corner_radius == 'rounded' or image_corner_radius == 'full' or image_corner_radius == 'custom' or image_corner_radius == 'radius_2' or image_corner_radius == 'radius_4' or image_corner_radius == 'radius_6' or image_corner_radius == 'radius_8' or image_corner_radius == 'radius_12' or image_corner_radius == 'radius_16' or image_corner_radius == 'radius_24' or image_corner_radius == 'radius_32'
    assign image_legacy_corner_radius = image_corner_radius | plus: 0
    if image_legacy_corner_radius > 0
      assign image_corner_radius = 'custom'
      assign image_custom_corner_radius = image_legacy_corner_radius
      if image_custom_corner_radius > 40
        assign image_custom_corner_radius = 40
      endif
    else
      assign image_corner_radius = 'square'
    endif
  endunless

  if image_custom_corner_radius < 0 or image_custom_corner_radius > 40
    assign image_custom_corner_radius = 0
  endif

  assign image_radius_value = 'var(--media-radius, var(--radius-square))'
  case image_corner_radius
    when 'radius_2', 'radius_4', 'radius_6', 'radius_8', 'radius_12', 'radius_16', 'radius_24', 'radius_32'
      assign image_radius_value = image_corner_radius | replace: 'radius_', 'var(--radius-' | append: ')'
    when 'square'
      assign image_radius_value = 'var(--radius-square)'
    when 'rounded'
      assign image_radius_value = 'var(--radius-rounded)'
    when 'full'
      assign image_radius_value = 'var(--radius-pill)'
    when 'custom'
      assign image_radius_value = image_custom_corner_radius | append: 'px'
  endcase

  assign padding_top = block.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign padding_left = block.settings.padding_left | default: 0 | plus: 0
  assign padding_right = block.settings.padding_right | default: 0 | plus: 0
  assign padding_top_mobile = block.settings.padding_top_mobile | default: 0 | plus: 0
  assign padding_bottom_mobile = block.settings.padding_bottom_mobile | default: 0 | plus: 0
  assign padding_left_mobile = block.settings.padding_left_mobile | default: 0 | plus: 0
  assign padding_right_mobile = block.settings.padding_right_mobile | default: 0 | plus: 0

  assign image_class = 'image-block media-hover-zoom size-style size-style--contain image-block--ratio-desktop-' | append: image_ratio_desktop_setting
  assign image_class = image_class | append: ' image-block--width-' | append: image_width_desktop_setting
  if block.settings.image_fit == 'contain' and block.settings.limit_width_desktop and image_width_desktop_setting == 'fit'
    assign image_class = image_class | append: ' image-block--contained-frame'
  endif
  if block.settings.show_image_first_mobile
    assign image_class = image_class | append: ' image-block--first-mobile'
  endif
%}

{% capture image_style %}
  {% liquid
    if block.settings.image_fit == 'contain'
      if block.settings.limit_width_desktop and image_width_desktop_setting == 'fit'
        assign image_width_desktop = image_max_width_desktop
      endif
      if block.settings.limit_width_mobile and image_width_mobile_setting == 'fit'
        assign image_width_mobile = image_max_width_mobile
      endif
    endif
  %}
  {% render 'size-style',
    width: image_width_desktop,
    max_width: image_max_width_desktop,
    width_mobile: image_width_mobile,
    max_width_mobile: image_max_width_mobile
  %}
  --image-block-ratio: {{ image_ratio_desktop }};
  --image-block-image-height: {{ image_height_desktop }};
  --image-block-ratio-mobile: {{ image_ratio_mobile }};
  --image-block-image-height-mobile: {{ image_height_mobile }};
  --image-block-padding-top: {{ padding_top }}px;
  --image-block-padding-bottom: {{ padding_bottom }}px;
  --image-block-padding-left: {{ padding_left }}px;
  --image-block-padding-right: {{ padding_right }}px;
  {% if block.settings.customize_mobile_padding %}
    --image-block-padding-top-mobile: {{ padding_top_mobile }}px;
    --image-block-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --image-block-padding-left-mobile: {{ padding_left_mobile }}px;
    --image-block-padding-right-mobile: {{ padding_right_mobile }}px;
  {% endif %}
  --image-block-overlay: {{ effective_overlay | default: 'transparent' | escape }};
  --image-block-radius: {{ image_radius_value }};
  {% if block.settings.background_color != blank %}--image-block-background: {{ block.settings.background_color }};{% endif %}
  {% if block.settings.image_fit == 'contain' %}--image-block-fit: contain;{% endif %}
{% endcapture %}
{% assign image_style = image_style | strip | replace: '\n', ' ' %}

<div
  class="{{ image_class }}"
  style="{{ image_style }}"
  {% render 'block-animation-attributes', settings: block.settings %}
    {{ block.shopify_attributes }}
>
  {% capture image_sizes %}(min-width: 768px) {{ image_size_desktop }}, {{ image_size_mobile }}{% endcapture %}
  {% liquid
    assign image_auto_sizes = true
    if block.settings.limit_width_desktop and block.settings.limit_width_mobile
      assign image_auto_sizes = false
    endif
  %}
  {% render 'image',
    image: image_source,
    mobile_image: mobile_image_source,
    url: block.settings.image_link,
    open_in_new_tab: block.settings.open_in_new_tab,
    alt: block.settings.alt_text,
    class: 'image-block__media media-hover-zoom__media',
    width: 2400,
    widths: '70, 140, 200, 400, 600, 800, 1200, 1600, 2400',
    sizes: image_sizes,
    auto_sizes: image_auto_sizes
  %}
</div>

{% stylesheet %}
  .image-block {
    display: block;
    min-width: 0;
    padding-top: var(--image-block-padding-top, 0px);
    padding-right: var(--image-block-padding-right, 0px);
    padding-bottom: var(--image-block-padding-bottom, 0px);
    padding-left: var(--image-block-padding-left, 0px);
  }

  .image-block__media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: var(--image-block-overlay, transparent);
    pointer-events: none;
  }

  .image-block__media {
    background-color: var(--image-block-background, transparent);
    width: 100%;
    max-width: 100%;
    aspect-ratio: var(--image-block-ratio, auto);
    border-radius: var(--image-block-radius, 0px);
  }

  .image-block--contained-frame {
    contain: inline-size;
    contain-intrinsic-inline-size: var(--size-style-width);
  }

  .image-block .image-block__media > picture,
  .image-block .image-block__media > picture > img,
  .image-block .image-block__media > img,
  .image-block .image-block__media .image__placeholder {
    display: block;
    width: 100%;
    height: var(--image-block-image-height, auto);
  }

  .image-block .image-block__media > img,
  .image-block .image-block__media > picture > img {
    object-fit: var(--image-block-fit, cover);
  }

  .image-block__media :where(picture, img) {
    border-radius: inherit;
  }

  @media (max-width: 767.98px) {
    .image-block--contained-frame {
      contain-intrinsic-inline-size: var(--size-style-width-mobile, var(--size-style-width));
    }
    .image-block--first-mobile {
      order: -1;
    }

    .image-block {
      padding-top: var(--image-block-padding-top-mobile, var(--image-block-padding-top, 0px));
      padding-right: var(--image-block-padding-right-mobile, var(--image-block-padding-right, 0px));
      padding-bottom: var(--image-block-padding-bottom-mobile, var(--image-block-padding-bottom, 0px));
      padding-left: var(--image-block-padding-left-mobile, var(--image-block-padding-left, 0px));
    }

    .image-block__media {
      aspect-ratio: var(--image-block-ratio-mobile, var(--image-block-ratio, auto));
    }

    .image-block .image-block__media > picture,
    .image-block .image-block__media > picture > img,
    .image-block .image-block__media > img,
    .image-block .image-block__media .image__placeholder {
      height: var(--image-block-image-height-mobile, var(--image-block-image-height, auto));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
