{% doc %}
  Crossed ribbon slot. Always uses the shared Marquee renderer and runtime.
{% enddoc %}
{% capture marquee_child_blocks %}{% content_for 'blocks' %}{% endcapture %}
{% render 'marquee-content', marquee_settings: block.settings, children: marquee_child_blocks, attributes: block.shopify_attributes, enable_parallax: block.settings.enable_parallax, show_top_divider: block.settings.show_top_divider, show_bottom_divider: block.settings.show_bottom_divider, show_blurred_edges: block.settings.show_blurred_edges %}
{{ 'component-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'marquee.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "t:general.marquee",
  "tag": null,
  "blocks": [
    {
      "type": "_marquee-heading"
    },
    {
      "type": "_marquee-text"
    },
    {
      "type": "_marquee-image"
    },
    {
      "type": "_marquee-icon"
    },
    {
      "type": "_marquee-button"
    },
    {
      "type": "_marquee-countdown-timer"
    },
    {
      "type": "_marquee-coupon-code"
    },
    {
      "type": "_marquee-divider"
    },
    {
      "type": "_marquee-group"
    },
    {
      "type": "marquee-item"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_top_divider",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_divider",
      "label": "Show bottom divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_blurred_edges",
      "label": "Show blurred edges",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Enable parallax effect",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Speed",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1,
      "unit": "x"
    },
    {
      "type": "select",
      "id": "animation_direction",
      "label": "Motion direction",
      "options": [
        {
          "value": "backward",
          "label": "Left"
        },
        {
          "value": "forward",
          "label": "Right"
        }
      ],
      "default": "backward"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Desktop width",
      "options": [
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "select",
      "id": "color_type",
      "label": "Type",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.appearance_type.inherit"
        },
        {
          "value": "scheme",
          "label": "t:options.appearance_type.scheme"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.color_type == 'scheme' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "t:labels.background_color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:labels.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:labels.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:labels.mobile_left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:labels.mobile_right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ]
}
{% endschema %}
