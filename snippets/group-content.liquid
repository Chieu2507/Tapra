{% doc %}
  Renders a layout group that composes theme and app blocks in a horizontal or
  vertical flow. The group owns its local layout, surface, border, overlay,
  and spacing without changing the typography contract of its children. Parent
  layouts should position this block without overriding its local alignment.

  Group is a generic composition surface, so it accepts any available child
  block. Product-specific blocks keep their product context when this group is
  nested inside Product Details; outside a product-aware parent they render
  according to their own empty-state behavior.

  @param {object} block - Owning Group block
  @param {object} section - Owning section
  @param {string} children - Captured child blocks
  @param {string} [container_class] - Optional shared container classes
  @param {string} [extra_class] - Classes on the Group's visible surface

  @example
  {% content_for 'block', type: 'group', id: 'group' %}
{% enddoc %}
{% capture effective_overlay %}{% render 'overlay-background', overlay_settings: block.settings, color_id: 'overlay_color', enabled_id: 'show_overlay', style_id: 'overlay_style', as_image: true %}{% endcapture %}
{% assign effective_overlay = effective_overlay | strip %}

{% liquid
  assign group_direction = block.settings.direction | default: block.settings.layout_direction | default: 'vertical'
  unless group_direction == 'horizontal' or group_direction == 'vertical' or group_direction == 'group--horizontal' or group_direction == 'group--vertical'
    assign group_direction = 'vertical'
  endunless
  if group_direction == 'group--horizontal'
    assign group_direction = 'horizontal'
  elsif group_direction == 'group--vertical'
    assign group_direction = 'vertical'
  endif

  assign group_alignment_source = block.settings.alignment | default: 'left'
  if group_direction == 'horizontal'
    assign group_alignment_source = block.settings.horizontal_alignment | default: group_alignment_source
  endif

  assign group_alignment = 'start'
  assign group_justify = 'flex-start'
  case group_alignment_source
    when 'center'
      assign group_alignment = 'center'
      assign group_justify = 'center'
    when 'right', 'end', 'flex-end'
      assign group_alignment = 'end'
      assign group_justify = 'flex-end'
    when 'space-between'
      assign group_justify = 'space-between'
    else
      assign group_alignment = 'start'
  endcase

  assign group_height_mode = block.settings.height | default: 'fit'
  unless group_height_mode == 'fit' or group_height_mode == 'fill'
    assign group_height_mode = 'fit'
  endunless

  assign group_position_source = 'top'
  if group_direction == 'horizontal'
    assign group_position_source = block.settings.position_horizontal | default: 'center'
  elsif group_height_mode == 'fill'
    assign group_position_source = block.settings.position | default: 'center'
  endif
  assign group_position_name = group_position_source
  case group_position_name
    when 'center'
      assign group_position_name = 'center'
    when 'bottom', 'flex-end'
      assign group_position_name = 'bottom'
    when 'space-between'
      assign group_position_name = 'space-between'
    else
      assign group_position_name = 'top'
  endcase

  assign group_vertical_on_mobile = false
  if group_direction == 'horizontal' and block.settings.customize_mobile_alignment
    assign group_vertical_on_mobile = true
  endif

  assign group_alignment_mobile = group_alignment
  assign group_justify_mobile = group_justify
  assign group_mobile_alignment_enabled = false
  if group_direction == 'vertical' or group_vertical_on_mobile
    assign group_mobile_alignment_enabled = true
  endif
  assign group_alignment_mobile_source = block.settings.alignment_mobile | default: 'left'
  unless group_alignment_mobile_source == 'left' or group_alignment_mobile_source == 'center' or group_alignment_mobile_source == 'right'
    assign group_alignment_mobile_source = 'left'
  endunless
  if group_mobile_alignment_enabled
    case group_alignment_mobile_source
      when 'center'
        assign group_alignment_mobile = 'center'
        assign group_justify_mobile = 'center'
      when 'right'
        assign group_alignment_mobile = 'end'
        assign group_justify_mobile = 'flex-end'
      else
        assign group_alignment_mobile = 'start'
        assign group_justify_mobile = 'flex-start'
    endcase
  endif

  assign group_flow_mobile_alignment = blank
  if group_mobile_alignment_enabled
    assign group_flow_mobile_alignment = group_alignment_mobile
  endif

  assign group_width_mode = block.settings.width | default: 'fit'
  unless group_width_mode == 'fit' or group_width_mode == 'fill' or group_width_mode == 'custom'
    assign group_width_mode = 'fit'
  endunless
  assign group_width_custom = block.settings.width_custom | default: 100 | plus: 0
  if group_width_custom < 10 or group_width_custom > 100
    assign group_width_custom = 100
  endif
  assign group_width = 'fit-content'
  if group_width_mode == 'fill'
    assign group_width = '100%'
  elsif group_width_mode == 'custom'
    assign group_width = group_width_custom | append: '%'
  endif
  assign group_limit_width = false
  if group_width_mode != 'fit' and block.settings.limit_width
    assign group_limit_width = true
  endif
  assign group_max_width = block.settings.max_width | default: 640 | plus: 0
  if group_max_width < 320 or group_max_width > 1200
    assign group_max_width = 640
  endif
  assign group_size_max_width = blank
  if group_limit_width
    assign group_size_max_width = group_max_width | append: 'px'
  endif

  assign group_width_mobile_mode = block.settings.width_mobile | default: 'fill'
  unless group_width_mobile_mode == 'fit' or group_width_mobile_mode == 'fill' or group_width_mobile_mode == 'custom'
    assign group_width_mobile_mode = group_width_mode
  endunless
  assign group_width_custom_mobile = block.settings.width_custom_mobile | default: 100 | plus: 0
  if group_width_custom_mobile < 10 or group_width_custom_mobile > 100
    assign group_width_custom_mobile = 100
  endif
  assign group_width_mobile = 'fit-content'
  if group_width_mobile_mode == 'fill'
    assign group_width_mobile = '100%'
  elsif group_width_mobile_mode == 'custom'
    assign group_width_mobile = group_width_custom_mobile | append: '%'
  endif
  assign group_limit_width_mobile = false
  if group_width_mobile_mode != 'fit' and block.settings.limit_width_mobile
    assign group_limit_width_mobile = true
  endif
  assign group_max_width_mobile = block.settings.max_width_mobile | default: 480 | plus: 0
  if group_max_width_mobile < 100 or group_max_width_mobile > 800
    assign group_max_width_mobile = 480
  endif
  assign group_size_max_width_mobile = blank
  if group_limit_width_mobile
    assign group_size_max_width_mobile = group_max_width_mobile | append: 'px'
  elsif group_limit_width
    assign group_size_max_width_mobile = '100%'
  endif

  assign group_gap_desktop = block.settings.gap_desktop | default: 16 | plus: 0
  if group_gap_desktop < 0 or group_gap_desktop > 200
    assign group_gap_desktop = 16
  endif
  assign group_gap_mobile = block.settings.gap_mobile | default: 12 | plus: 0
  if group_gap_mobile < 0 or group_gap_mobile > 100
    assign group_gap_mobile = 12
  endif

  assign group_border_type = block.settings.border_type | default: 'none'
  unless group_border_type == 'none' or group_border_type == 'solid' or group_border_type == 'dashed' or group_border_type == 'dotted' or group_border_type == 'double'
    assign group_border_type = 'none'
  endunless

  assign group_radius = block.settings.corner_radius | default: 'square'
  unless group_radius == 'square' or group_radius == 'slightly_rounded' or group_radius == 'rounded' or group_radius == 'pill' or group_radius == 'radius_2' or group_radius == 'radius_4' or group_radius == 'radius_6' or group_radius == 'radius_8' or group_radius == 'radius_12' or group_radius == 'radius_16' or group_radius == 'radius_24' or group_radius == 'radius_32'
    assign group_radius = 'square'
  endunless

  assign group_shadow = block.settings.shadow | default: 'none'
  unless group_shadow == 'none' or group_shadow == 'small' or group_shadow == 'medium' or group_shadow == 'large'
    assign group_shadow = 'none'
  endunless

  assign group_backdrop_blur = block.settings.backdrop_blur | default: 0 | plus: 0
  if group_backdrop_blur < 0 or group_backdrop_blur > 40
    assign group_backdrop_blur = 0
  endif

  assign padding_top = block.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign padding_left = block.settings.padding_left | default: 0 | plus: 0
  assign padding_right = block.settings.padding_right | default: 0 | plus: 0
  assign padding_top_mobile = block.settings.padding_top_mobile | default: 0 | plus: 0
  assign padding_bottom_mobile = block.settings.padding_bottom_mobile | default: 0 | plus: 0
  assign padding_left_mobile = block.settings.padding_left_mobile | default: 0 | plus: 0
  assign padding_right_mobile = block.settings.padding_right_mobile | default: 0 | plus: 0

  if padding_top < 0 or padding_top > 200
    assign padding_top = 0
  endif
  if padding_bottom < 0 or padding_bottom > 200
    assign padding_bottom = 0
  endif
  if padding_left < 0 or padding_left > 200
    assign padding_left = 0
  endif
  if padding_right < 0 or padding_right > 200
    assign padding_right = 0
  endif
  if padding_top_mobile < 0 or padding_top_mobile > 200
    assign padding_top_mobile = 0
  endif
  if padding_bottom_mobile < 0 or padding_bottom_mobile > 200
    assign padding_bottom_mobile = 0
  endif
  if padding_left_mobile < 0 or padding_left_mobile > 200
    assign padding_left_mobile = 0
  endif
  if padding_right_mobile < 0 or padding_right_mobile > 200
    assign padding_right_mobile = 0
  endif

  assign group_appearance_type = block.settings.appearance_type | default: 'inherit'
  unless group_appearance_type == 'inherit' or group_appearance_type == 'scheme'
    assign group_appearance_type = 'inherit'
  endunless
  assign group_scheme = blank
  if group_appearance_type == 'scheme'
    assign group_scheme = block.settings.color_scheme | default: 'scheme-1'
    if block.settings.color_scheme.id != blank
      assign group_scheme = block.settings.color_scheme.id
    endif
    assign group_scheme = group_scheme | default: 'scheme-1' | handleize
  endif

  assign group_wrap = 'nowrap'
  if group_direction == 'horizontal' and block.settings.wrap
    assign group_wrap = 'wrap'
  endif
  assign group_class = 'group size-style layout-flow layout-flow--responsive group--' | append: group_direction
  if extra_class != blank
    assign group_class = group_class | append: ' ' | append: extra_class
  endif
  assign group_class = group_class | append: ' group--align-' | append: group_alignment
  assign group_class = group_class | append: ' group--width-' | append: group_width_mode
  assign group_class = group_class | append: ' group--height-' | append: group_height_mode
  assign group_class = group_class | append: ' group--radius-' | append: group_radius
  assign group_class = group_class | append: ' group--shadow-' | append: group_shadow
  assign group_class = group_class | append: ' group--border-' | append: group_border_type
  assign group_class = group_class | append: ' group--appearance-' | append: group_appearance_type
  assign group_class = group_class | append: ' section-color-scope'
  if group_appearance_type == 'scheme'
    assign group_class = group_class | append: ' color-scheme ' | append: group_scheme
  endif
  if group_vertical_on_mobile
    assign group_class = group_class | append: ' group--mobile-vertical'
  endif
  if block.settings.use_theme_glass
    assign group_class = group_class | append: ' theme-glass'
  endif
  if group_backdrop_blur > 0
    assign group_class = group_class | append: ' backdrop-blur'
  else
    assign group_class = group_class | append: ' motion-block'
  endif
%}

{% capture group_style %}
  {% if block.settings.mobile_order != blank %}--group-order-mobile: {{ block.settings.mobile_order | plus: 0 }};{% endif %}
  {% render 'layout-flow-group-style',
    direction: group_direction,
    wrap: group_wrap,
    position: group_position_name,
    alignment: group_alignment,
    horizontal_alignment: group_justify,
    mobile_vertical: group_vertical_on_mobile,
    mobile_alignment: group_flow_mobile_alignment,
    mobile_justify: group_justify_mobile,
    gap: group_gap_desktop,
    gap_mobile: group_gap_mobile
  %}
  {% render 'size-style',
    width: group_width,
    max_width: group_size_max_width,
    width_mobile: group_width_mobile,
    max_width_mobile: group_size_max_width_mobile
  %}
  {% if group_mobile_alignment_enabled and group_alignment_mobile != group_alignment %}--group-align-mobile: {{ group_alignment_mobile }};{% endif %}
  {% if block.settings.border_color != blank %}--group-border-color: {{ block.settings.border_color | escape }};{% endif %}
  {% if padding_top != 0 %}--group-padding-top: {{ padding_top }}px;{% endif %}
  {% if padding_bottom != 0 %}--group-padding-bottom: {{ padding_bottom }}px;{% endif %}
  {% if padding_left != 0 %}--group-padding-left: {{ padding_left }}px;{% endif %}
  {% if padding_right != 0 %}--group-padding-right: {{ padding_right }}px;{% endif %}

  {% if block.settings.customize_mobile_padding %}
    {% if padding_top_mobile != padding_top %}--group-padding-top-mobile: {{ padding_top_mobile }}px;{% endif %}
    {% if padding_bottom_mobile != padding_bottom %}--group-padding-bottom-mobile: {{ padding_bottom_mobile }}px;{% endif %}
    {% if padding_left_mobile != padding_left %}--group-padding-left-mobile: {{ padding_left_mobile }}px;{% endif %}
    {% if padding_right_mobile != padding_right %}--group-padding-right-mobile: {{ padding_right_mobile }}px;{% endif %}
  {% endif %}
  {% if group_appearance_type == 'scheme' %}
    {% if block.settings.background_color != blank %}--group-background-color: {{ block.settings.background_color | escape }};{% endif %}
    {% if block.settings.background_image != blank %}--group-background-image: url('{{ block.settings.background_image | image_url: width: 2400 }}');{% endif %}
  {% endif %}
  --group-overlay-background: {{ effective_overlay | default: 'linear-gradient(transparent, transparent)' | escape }};
  {% if group_backdrop_blur > 0 %}--backdrop-blur: {{ group_backdrop_blur }}px;{% endif %}
{% endcapture %}
{% assign group_style = group_style | strip %}

{% if container_class != blank %}<div class="{{ container_class }}">{% endif %}
<div
  class="{{ group_class }}"
  {% if group_style != blank %}style="{{ group_style }}"{% endif %}
  {% render 'block-animation-attributes', settings: block.settings %}
    {{ block.shopify_attributes }}
>
  {{ children }}
</div>


{% if container_class != blank %}</div>{% endif %}
{% render 'component-stylesheet', filename: 'component-blocks-group.css', section_index: section.index %}
