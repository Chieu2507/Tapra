{% doc %}
  Emits only spacing overrides for the Editorial composition, preserving mobile zero.
  @param {object} settings - Owning block settings
{% enddoc %}
{%- assign sides = 'top,bottom,left,right' | split: ',' -%}
{%- assign short = 'pt,pb,pl,pr' | split: ',' -%}
{%- for side in sides -%}
  {%- assign key = 'padding_' | append: side -%}
  {%- assign value = settings[key] | default: 0 -%}
  {%- assign token = short[forloop.index0] -%}
  {%- if value != 0 -%}--ce-{{ token }}:{{ value }}px;{%- endif -%}
  {%- if settings.customize_mobile_padding -%}
    {%- assign mobile_key = key | append: '_mobile' -%}
    {%- assign mobile = settings[mobile_key] | default: 0 -%}
    {%- if mobile != value -%}--ce-{{ token }}-mobile:{{ mobile }}px;{%- endif -%}
  {%- endif -%}
{%- endfor -%}
