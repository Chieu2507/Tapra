{% doc %}
  Shared rebuilt Marquee renderer for the general block and Media item slot.
  @param {object} marquee_settings - Shared Marquee content/layout settings
  @param {string} children - Rendered item blocks
  @param {string} attributes - Shopify block selection attributes
  @param {boolean} [enable_parallax] - Scroll-driven track motion
  @param {boolean} [show_top_divider] - Top divider
  @param {boolean} [show_bottom_divider] - Bottom divider
  @param {boolean} [show_blurred_edges] - Viewport edge fade
  @param {boolean} [media_item] - Marks the fixed Media item slot
{% enddoc %}
{% liquid
  assign marquee_direction = marquee_settings.animation_direction | default: 'backward'
  unless marquee_direction == 'forward' or marquee_direction == 'backward'
    assign marquee_direction = 'forward'
  endunless

  assign marquee_speed = marquee_settings.animation_speed
  if marquee_speed == blank
    assign marquee_speed = 0.6
  else
    assign marquee_speed = marquee_speed | plus: 0
  endif
  if marquee_speed < 0 or marquee_speed > 2
    assign marquee_speed = 0.6
  endif
  assign padding_top = marquee_settings.padding_top
  if padding_top == blank
    assign padding_top = 0
  else
    assign padding_top = padding_top | plus: 0
  endif
  assign padding_bottom = marquee_settings.padding_bottom
  if padding_bottom == blank
    assign padding_bottom = 0
  else
    assign padding_bottom = padding_bottom | plus: 0
  endif
  assign marquee_gap_desktop = marquee_settings.gap_desktop
  if marquee_gap_desktop == blank
    assign marquee_gap_desktop = 40
  else
    assign marquee_gap_desktop = marquee_gap_desktop | plus: 0
  endif
  assign marquee_gap_mobile = marquee_settings.gap_mobile
  if marquee_gap_mobile == blank
    assign marquee_gap_mobile = 30
  else
    assign marquee_gap_mobile = marquee_gap_mobile | plus: 0
  endif
  assign padding_top_mobile = marquee_settings.padding_top_mobile | default: padding_top | plus: 0
  assign padding_bottom_mobile = marquee_settings.padding_bottom_mobile | default: padding_bottom | plus: 0
%}

{% capture marquee_style %}
  {% if marquee_settings.background_color != blank %}--marquee-background-color: {{ marquee_settings.background_color | escape }};{% endif %}
  {% for edge in (1..2) %}
    {% assign side = 'left' %}
    {% if edge == 2 %}{% assign side = 'right' %}{% endif %}
    {% assign padding_key = 'padding_' | append: side %}
    {% assign padding_value = marquee_settings[padding_key] | default: 0 | at_least: 0 | at_most: 100 %}
    {% if padding_value != 0 %}--marquee-padding-{{ side }}: {{ padding_value }}px;{% endif %}
    {% if marquee_settings.customize_mobile_padding %}
      {% assign mobile_key = padding_key | append: '_mobile' %}
      --marquee-padding-{{ side }}-mobile: {{ marquee_settings[mobile_key] | default: 0 | at_least: 0 | at_most: 100 }}px;
    {% endif %}
  {% endfor %}
  --marquee-align: {% case marquee_settings.alignment %}{% when 'top' %}flex-start{% when 'bottom' %}flex-end{% else %}center{% endcase %};
  {% if marquee_settings.width == 'custom' %}--marquee-width: {{ marquee_settings.custom_width | default: 50 }}%;{% endif %}
  {% if padding_top != 0 %}--marquee-padding-top: {{ padding_top }}px;{% endif %}
  {% if padding_bottom != 0 %}--marquee-padding-bottom: {{ padding_bottom }}px;{% endif %}
  {% if marquee_gap_desktop != 40 %}--marquee-gap: {{ marquee_gap_desktop }}px;{% endif %}
  {% if marquee_gap_mobile != 30 %}--marquee-gap-mobile: {{ marquee_gap_mobile }}px;{% endif %}
  {% if marquee_settings.customize_mobile_padding %}
    --marquee-padding-top-mobile: {{ padding_top_mobile }}px;
    --marquee-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  {% endif %}
{% endcapture %}
{% assign marquee_style = marquee_style | strip | replace: '\n', ' ' %}

{% liquid
  assign marquee_class = 'elara-marquee elara-marquee--block elara-marquee--' | append: marquee_direction
  if marquee_settings.color_type == 'scheme'
    assign marquee_class = marquee_class | append: ' section-color-scope color-scheme ' | append: marquee_settings.color_scheme
  endif %}
{% if marquee_speed == 0 %}
  {% assign marquee_class = marquee_class | append: ' elara-marquee--static' %}
{% endif %}

<div
  class="{{ marquee_class }}"
  {% if media_item %}data-media-marquee{% endif %}
  data-marquee-speed="{{ marquee_speed }}"
  data-marquee-parallax="{{ enable_parallax }}"
  {% if show_top_divider %}data-marquee-top-divider{% endif %}
  {% if show_bottom_divider %}data-marquee-bottom-divider{% endif %}
  {% if show_blurred_edges %}data-marquee-blurred-edges{% endif %}
  {{ attributes }}
  {% if marquee_style != blank %}style="{{ marquee_style }}"{% endif %}
>
  <div class="elara-marquee__container">
    <div class="elara-marquee__viewport" role="region" aria-label="Marquee">
      <div class="elara-marquee__track">
        {{ children }}
      </div>
    </div>
  </div>
</div>
