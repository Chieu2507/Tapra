    "tapra_faq": {
      "type": "faq-accordion",
      "blocks": {
        "header": {
          "type": "group",
          "settings": {
            "alignment": "left",
            "gap_desktop": 16,
            "gap_mobile": 16,
            "width": "fill"
          },
          "blocks": {
            "faq_header_1": {
              "type": "heading",
              "settings": {
                "text": "<p>A few things you might be wondering.</p>",
                "heading_size": "xl",
                "html_tag": "h2",
                "width": "fill"
              }
            }
          },
          "block_order": [
            "faq_header_1"
          ]
        },
        "questions": {
          "type": "faq_accordion",
          "settings": {
            "use_elara_layout": true,
            "style": "boxed",
            "icon": "plus",
            "dividers": false,
            "question_font": "body",
            "question_body_font_size": "md",
            "border_thickness": 0,
            "shadow": "none",
            "padding": "custom",
            "padding_top": 18,
            "padding_right": 22,
            "padding_bottom": 18,
            "padding_left": 22,
            "gap_desktop": 10,
            "gap_mobile": 10,
            "device": "desktop",
            "width": "custom",
            "custom_width": 57,
            "width_mobile": "fill",
            "color_type": "inherit",
            "answer_font_size": "md",
            "single_open": true,
            "item_background": "#ffffff0f",
            "corner_radius": "radius_16"
          },
          "blocks": {
            "faq_question_1": {
              "type": "faq_item",
              "settings": {
                "use_elara_layout": true,
                "question": "How long is the warranty?",
                "show_question_icon": false,
                "initially_open": true,
                "pointer_light": true
              },
              "blocks": {
                "faq_question_1_1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>12 months on the board and PCB. Manufacturing faults are replaced within the first 30 days.</p>",
                    "text_size": "md",
                    "text_color": "#bfe3ffb8",
                    "width": "fill"
                  }
                }
              },
              "block_order": [
                "faq_question_1_1"
              ]
            },
            "faq_question_2": {
              "type": "faq_item",
              "settings": {
                "use_elara_layout": true,
                "question": "Can I change switches myself?",
                "show_question_icon": false,
                "initially_open": false,
                "pointer_light": true
              },
              "blocks": {
                "faq_question_2_1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. The hot-swap PCB lets you pull out switches and press in new ones, no soldering.</p>",
                    "text_size": "md",
                    "text_color": "#bfe3ffb8",
                    "width": "fill"
                  }
                }
              },
              "block_order": [
                "faq_question_2_1"
              ]
            },
            "faq_question_3": {
              "type": "faq_item",
              "settings": {
                "use_elara_layout": true,
                "question": "Does it work with Mac and Windows?",
                "show_question_icon": false,
                "initially_open": false,
                "pointer_light": true
              },
              "blocks": {
                "faq_question_3_1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. The board detects your system and remaps modifier keys with one shortcut.</p>",
                    "text_size": "md",
                    "text_color": "#bfe3ffb8",
                    "width": "fill"
                  }
                }
              },
              "block_order": [
                "faq_question_3_1"
              ]
            },
            "faq_question_4": {
              "type": "faq_item",
              "settings": {
                "use_elara_layout": true,
                "question": "How fast is shipping?",
                "show_question_icon": false,
                "initially_open": false,
                "pointer_light": true
              },
              "blocks": {
                "faq_question_4_1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Orders ship in 1–2 business days. Delivery takes 3–7 days depending on your region.</p>",
                    "text_size": "md",
                    "text_color": "#bfe3ffb8",
                    "width": "fill"
                  }
                }
              },
              "block_order": [
                "faq_question_4_1"
              ]
            }
          },
          "block_order": [
            "faq_question_1",
            "faq_question_2",
            "faq_question_3",
            "faq_question_4"
          ]
        }
      },
